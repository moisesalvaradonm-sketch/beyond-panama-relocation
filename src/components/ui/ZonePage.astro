---
import Layout from '../../layouts/Layout.astro';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  emoji: string;
  zone: string;
  locationName: string;
  climate: string;
  rentRange: string;
  profile: string;
  internet: string;
  intro: string;
  highlights: string[];
  considerations: string[];
  neighborhoods?: { name: string; desc: string }[];
  heroImage?: string;
}

const {
  lang, title, description, emoji, zone, locationName,
  climate, rentRange, profile, internet,
  intro, highlights, considerations, neighborhoods = [],
  heroImage,
} = Astro.props;

const backHref = lang === 'es' ? '/es/zonas' : lang === 'fr' ? '/fr/zones' : '/en/areas';
const backLabel = lang === 'es' ? '← Todas las zonas' : lang === 'fr' ? '← Toutes les zones' : '← All areas';
const quizHref = `/${lang}/quiz`;
const quizLabel = lang === 'es' ? 'Encontrar tu ruta →' : lang === 'fr' ? 'Trouver ma route →' : 'Find your route →';

const stats = [
  { label: lang === 'es' ? 'Clima' : 'Climate', value: climate },
  { label: lang === 'es' ? 'Alquiler típico' : 'Typical rent', value: rentRange },
  { label: lang === 'es' ? 'Perfil expat' : 'Expat profile', value: profile },
  { label: 'Internet', value: internet },
];
---

<Layout {title} {description} {lang}>

  <!-- Hero -->
  <div class="relative min-h-[55vh] flex flex-col justify-end overflow-hidden bg-slate">
    {heroImage && (
      <img
        src={heroImage}
        alt={locationName}
        class="absolute inset-0 w-full h-full object-cover object-center opacity-40"
        loading="eager"
        decoding="async"
      />
    )}
    <!-- Gradient overlay always present -->
    <div class="absolute inset-0 bg-gradient-to-t from-slate via-slate/60 to-slate/20 pointer-events-none" aria-hidden="true"></div>

    <div class="relative max-w-4xl mx-auto px-6 md:px-8 pb-14 pt-28 w-full">
      <a
        href={backHref}
        class="inline-flex items-center gap-1.5 text-white/50 hover:text-white/80 text-xs tracking-[0.12em] uppercase transition-colors mb-8"
      >
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        {backLabel}
      </a>
      <span class="eyebrow" data-animate>{lang === 'es' ? 'Guía de zona' : lang === 'fr' ? 'Guide de zone' : 'Area guide'}</span>
      <h1 class="font-serif text-4xl md:text-5xl lg:text-6xl text-white leading-[1.05] mb-5 max-w-2xl" data-animate data-delay="1">
        {title}
      </h1>
      <p class="text-white/60 text-base md:text-lg leading-relaxed max-w-xl" data-animate data-delay="2">
        {intro}
      </p>
    </div>
  </div>

  <!-- Stats strip -->
  <div class="border-b border-jade/12 bg-white" data-animate>
    <div class="max-w-4xl mx-auto px-6 md:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 divide-x divide-jade/10">
        {stats.map((stat, i) => (
          <div class="py-6 px-4 first:pl-0 last:pr-0" data-animate data-delay={String(i + 1)}>
            <p class="text-[0.65rem] text-slate-mid uppercase tracking-[0.18em] mb-1.5">{stat.label}</p>
            <p class="font-serif text-slate text-sm font-semibold leading-snug">{stat.value}</p>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Body content -->
  <article class="max-w-4xl mx-auto px-6 md:px-8 py-16 md:py-20">

    <!-- Highlights -->
    <section class="mb-16" data-animate>
      <h2 class="font-serif text-2xl md:text-3xl text-slate mb-8">
        {lang === 'es' ? `Por qué los expats eligen ${locationName}` : lang === 'fr' ? `Pourquoi les expats choisissent ${locationName}` : `Why Expats Choose ${locationName}`}
      </h2>
      <ul class="space-y-4">
        {highlights.map((h, i) => (
          <li class="flex gap-4 items-start" data-animate data-delay={String((i % 4) + 1)}>
            <span class="mt-1 flex-shrink-0 w-5 h-5 rounded-full bg-jade/10 flex items-center justify-center" aria-hidden="true">
              <svg class="w-2.5 h-2.5 text-jade" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
            </span>
            <span class="text-slate-mid leading-relaxed">{h}</span>
          </li>
        ))}
      </ul>
    </section>

    <hr class="divider-editorial mb-16" />

    <!-- Considerations -->
    <section class="mb-16" data-animate>
      <h2 class="font-serif text-2xl md:text-3xl text-slate mb-8">
        {lang === 'es' ? `Qué considerar antes de mudarte a ${locationName}` : lang === 'fr' ? `Ce qu'il faut savoir avant de s'installer à ${locationName}` : `What to Know Before Moving to ${locationName}`}
      </h2>
      <ul class="space-y-4">
        {considerations.map((c, i) => (
          <li class="flex gap-4 items-start" data-animate data-delay={String((i % 4) + 1)}>
            <span class="mt-1 flex-shrink-0 w-5 h-5 rounded-full bg-coral/10 flex items-center justify-center" aria-hidden="true">
              <svg class="w-2.5 h-2.5 text-coral" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
            </span>
            <span class="text-slate-mid leading-relaxed">{c}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- Neighborhoods -->
    {neighborhoods.length > 0 && (
      <section class="mb-16" data-animate>
        <hr class="divider-editorial mb-16" />
        <h2 class="font-serif text-2xl md:text-3xl text-slate mb-8">
          {lang === 'es' ? `Barrios y zonas de ${locationName}` : lang === 'fr' ? `Quartiers de ${locationName}` : `${locationName} Neighborhoods`}
        </h2>
        <div class="grid md:grid-cols-2 gap-4">
          {neighborhoods.map((n, i) => (
            <div
              class="p-6 border border-jade/10 border-l-2 border-l-jade hover:border-l-gold transition-colors"
              data-animate
              data-delay={String((i % 4) + 1)}
            >
              <p class="font-serif text-sm font-semibold text-slate mb-2">{n.name}</p>
              <p class="text-xs text-slate-mid leading-relaxed">{n.desc}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Slot for extra content -->
    <slot />

    <!-- CTA -->
    <div class="mt-16 bg-slate px-8 py-12 text-center" data-animate>
      <span class="eyebrow" style="color: rgba(196,169,109,0.7)">{lang === 'es' ? 'Siguiente paso' : lang === 'fr' ? 'Prochaine étape' : 'Next step'}</span>
      <h2 class="font-serif text-2xl md:text-3xl text-white mb-3">
        {lang === 'es' ? `¿${locationName} es para ti?` : lang === 'fr' ? `${locationName} est-il fait pour vous ?` : `Is ${locationName} right for you?`}
      </h2>
      <p class="text-white/50 text-sm mb-8 max-w-xs mx-auto leading-relaxed">
        {lang === 'es'
          ? 'Tu ruta te orienta en 2 minutos según tu presupuesto y estilo de vida.'
          : lang === 'fr'
          ? 'Votre route vous guide en 2 minutes selon votre budget et style de vie.'
          : 'Your route guides you in 2 minutes based on your budget and lifestyle.'}
      </p>
      <a
        href={quizHref}
        class="inline-flex items-center gap-2 px-7 py-3.5 bg-gold text-slate text-sm font-semibold rounded-sm hover:bg-gold-light transition-colors"
      >
        {quizLabel}
      </a>
    </div>

  </article>
</Layout>
