<style>
  .re-radio:checked + .re-radio-dot {
    background-color: #2a7d4f;
    border-color: #2a7d4f;
    box-shadow: inset 0 0 0 3px white;
  }
  .re-radio:checked ~ span:last-child {
    color: #1a2e25;
  }
  label:has(.re-radio:checked) {
    border-color: #2a7d4f;
    background-color: rgba(42, 125, 79, 0.04);
  }
  .re-checkbox:checked + .re-check-box {
    background-color: #2a7d4f;
    border-color: #2a7d4f;
  }
  .re-checkbox:checked + .re-check-box::after {
    content: '';
    display: block;
    width: 8px;
    height: 5px;
    border-left: 2px solid white;
    border-bottom: 2px solid white;
    transform: rotate(-45deg) translateY(-1px);
  }
  label:has(.re-checkbox:checked) {
    border-color: #2a7d4f;
    background-color: rgba(42, 125, 79, 0.04);
  }
  .re-step { animation: fadeStep 0.3s ease; }
  @keyframes fadeStep {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }
</style>

<script type="module">
  const wrapper    = document.getElementById('re-form-wrapper');
  const stepTitles = JSON.parse(wrapper.dataset.stepTitles);
  const txtNext    = wrapper.dataset.txtNext;
  const txtBack    = wrapper.dataset.txtBack;
  const txtSubmit  = wrapper.dataset.txtSubmit;
  const txtSubmitting = wrapper.dataset.txtSubmitting;
  const stepOf     = wrapper.dataset.stepOf;
  const steps       = document.querySelectorAll('.re-step');
  const progressBar = document.getElementById('re-progress-bar');
  const stepLabel   = document.getElementById('re-step-name');
  const stepCounter = document.getElementById('re-step-counter');
  const elBtnNext   = document.getElementById('re-btn-next');
  const elBtnBack   = document.getElementById('re-btn-back');
  const elBtnSubmit = document.getElementById('re-btn-submit');
  const form        = document.getElementById('re-form');
  const successEl   = document.getElementById('re-success');
  const totalSteps  = steps.length;

  let currentStep = 0;

  function showStep(idx) {
    steps.forEach((s, i) => {
      s.classList.toggle('hidden', i !== idx);
    });

    const pct = Math.round(((idx + 1) / totalSteps) * 100);
    if (progressBar) progressBar.style.width = `${pct}%`;
    if (stepLabel) stepLabel.textContent = stepTitles[idx];
    if (stepCounter) stepCounter.textContent = `${idx + 1} ${stepOf} ${totalSteps}`;

    const isLast = idx === totalSteps - 1;
    if (elBtnNext) {
      elBtnNext.classList.toggle('hidden', isLast);
      elBtnNext.classList.toggle('inline-flex', !isLast);
    }
    if (elBtnSubmit) {
      elBtnSubmit.classList.toggle('hidden', !isLast);
      elBtnSubmit.classList.toggle('inline-flex', isLast);
    }
    if (elBtnBack) {
      const showBack = idx > 0;
      elBtnBack.classList.toggle('hidden', !showBack);
      elBtnBack.classList.toggle('flex', showBack);
    }
  }

  function validateStep(idx) {
    const step = steps[idx];
    if (!step) return true;
    const radios = step.querySelectorAll('input[type="radio"][required]');
    const radioGroups = new Set();
    radios.forEach(r => radioGroups.add(r.getAttribute('name')));

    for (const name of radioGroups) {
      const checked = step.querySelector(`input[name="${name}"]:checked`);
      if (!checked) {
        const firstRadio = step.querySelector(`input[name="${name}"]`);
        firstRadio?.closest('[role="group"]')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return false;
      }
    }

    const requiredTextInputs = step.querySelectorAll('input[required], textarea[required]');
    for (const input of requiredTextInputs) {
      if (!input.value.trim()) {
        input.focus();
        return false;
      }
    }

    return true;
  }

  // On mobile, sr-only inputs can miss touch events — explicitly check the radio on label tap
  document.querySelectorAll('.re-radio-card').forEach(label => {
    label.addEventListener('click', () => {
      const radio = label.querySelector('input[type="radio"]');
      if (radio) {
        radio.checked = true;
        radio.dispatchEvent(new Event('change', { bubbles: true }));
      }
    });
  });

  elBtnNext?.addEventListener('click', () => {
    if (!validateStep(currentStep)) return;
    if (currentStep < totalSteps - 1) {
      currentStep++;
      showStep(currentStep);
      wrapper.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  });

  elBtnBack?.addEventListener('click', () => {
    if (currentStep > 0) {
      currentStep--;
      showStep(currentStep);
      wrapper.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  });

  form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!validateStep(currentStep)) return;

      if (elBtnSubmit) {
        elBtnSubmit.textContent = txtSubmitting;
        elBtnSubmit.setAttribute('disabled', 'true');
      }

      const data = new FormData(form);
      // Collect multi-value fields (areas checkboxes) as comma-separated string
      const payload: Record<string, string> = {};
      data.forEach((value, key) => {
        if (payload[key]) {
          payload[key] += ', ' + value;
        } else {
          payload[key] = String(value);
        }
      });
      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify(payload),
        });
        const json = await res.json();
        if (json.success) {
          if (form) form.classList.add('hidden');
          document.querySelector('#re-form-wrapper > .mb-8')?.classList.add('hidden');
          if (successEl) successEl.classList.remove('hidden');
        } else {
          throw new Error(json.message);
        }
      } catch {
        if (elBtnSubmit) {
          elBtnSubmit.textContent = txtSubmit;
          elBtnSubmit.removeAttribute('disabled');
        }
      }
  });

  showStep(0);
</script>
