---


<div
  id="re-form-wrapper"
  class="w-full"
  data-step-titles={JSON.stringify(stepTitles)}
  data-txt-next={strings.btnNext}
  data-txt-back={strings.btnBack}
  data-txt-submit={strings.btnSubmit}
  data-txt-submitting={strings.btnSubmitting}
  data-step-of={strings.stepOf}
>

  <!-- Progress header -->
  <div class="mb-8">
    <div id="re-step-label" class="flex items-center justify-between mb-3">
      <span class="text-xs font-semibold text-jade uppercase tracking-wide" id="re-step-name">{stepTitles[0]}</span>
      <span class="text-xs text-slate-mid" id="re-step-counter">1 {strings.stepOf} 5</span>
    </div>
    <div class="w-full bg-jade/10 rounded-full h-1.5">
      <div id="re-progress-bar" class="bg-jade h-1.5 rounded-full transition-all duration-500" style="width: 20%"></div>
    </div>
  </div>

  <!-- Main form -->
  <form
    id="re-form"
    novalidate
  >
    <input type="hidden" name="access_key" value="e5abb278-073f-446e-8ff3-a87ecdba7105" />
    <input type="hidden" name="subject" value={`Real Estate Inquiry — Beyond Panama Relocation (${lang.toUpperCase()})`} />
    <input type="hidden" name="from_name" value="Beyond Panama Relocation" />
    <input type="checkbox" name="botcheck" class="hidden" style="display:none" />

    <!-- STEP 1: Goal + Areas (multi-select) -->
    <div class="re-step" data-step="1">
      <!-- Q1: Goal (single select) -->
      <div class="mb-8">
        <label class="block font-serif text-lg text-slate mb-4">{strings.q1Label}</label>
        <div class="grid sm:grid-cols-2 gap-3" role="group">
          {strings.q1.map(opt => (
            <label class="re-radio-card flex items-center gap-3 p-4 rounded-xl border border-jade/15 bg-white cursor-pointer hover:border-jade/40 hover:bg-jade/3 transition-all group">
