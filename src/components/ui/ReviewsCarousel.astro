---
// ReviewsCarousel.astro
// Google-style review carousel. Replace PLACEHOLDER_REVIEWS with real data
// when the user provides them. Stars + verified badge + name + date + text.

export interface Review {
  name: string;
  avatar?: string;   // initials fallback when no photo
  rating: number;    // 1–5
  date: string;      // e.g. "hace 3 meses" / "3 months ago" / "il y a 3 mois"
  text: string;
}

interface Props {
  lang?: 'es' | 'en' | 'fr';
}

const { lang = 'es' } = Astro.props;

const labels = {
  es: {
    heading:  'Lo que dicen nuestros clientes',
    subtext:  'Reseñas reales de personas que confiaron en nosotros para su proceso de relocalización.',
    badge:    'Reseñas de Google',
    verified: 'Verificado',
    seeAll:   'Ver todas las reseñas en Google →',
  },
  en: {
    heading:  'What our clients say',
    subtext:  'Real reviews from people who trusted us with their relocation process.',
    badge:    'Google Reviews',
    verified: 'Verified',
    seeAll:   'See all reviews on Google →',
  },
  fr: {
    heading:  'Ce que disent nos clients',
    subtext:  'Avis réels de personnes qui nous ont fait confiance pour leur processus de relocalisation.',
    badge:    'Avis Google',
    verified: 'Vérifié',
    seeAll:   'Voir tous les avis sur Google →',
  },
};

const l = labels[lang];

// ── REAL GOOGLE REVIEWS ────────────────────────────────────────────────────────
// Reviews are shown in their original language (as on Google).
// Dates use relative format; update periodically to keep them current.
const ALL_REVIEWS: Review[] = [
  {
    name: 'José Rodríguez',
    avatar: 'JR',
    rating: 5,
    date: '2 months ago',
    text: 'My experience with Moisés and his team was excellent. From the beginning, they were very helpful and explained everything clearly. They made the relocation process much easier and were always available when I had questions. I would definitely recommend them to anyone considering moving to Panama.',
  },
  {
    name: 'Sarah Mitchell',
    avatar: 'SM',
    rating: 5,
    date: '3 months ago',
    text: 'We had a great experience working with Moisés during our relocation to Panama. He was always available to answer our questions and made the residency process much easier to understand. We really appreciated his patience, knowledge, and personal attention throughout the process.',
  },
  {
    name: 'Daniel Thompson',
    avatar: 'DT',
    rating: 5,
    date: '3 months ago',
    text: 'Moisés was extremely helpful from the beginning. He guided us through the different residency options and helped us understand what we needed to do before moving to Panama. Everything was explained clearly, and we always felt that we were in good hands. Highly recommended.',
  },
  {
    name: 'Michael Anderson',
    avatar: 'MA',
    rating: 5,
    date: '4 months ago',
    text: 'If you are considering moving to Panama, I highly recommend speaking with Moisés. He helped us not only with our residency process but also gave us useful guidance about settling in Panama. He was responsive, professional, and genuinely interested in helping us have a smooth experience.',
  },
  {
    name: 'Robert Johnson',
    avatar: 'RJ',
    rating: 5,
    date: '4 months ago',
    text: 'Nelson was excellent to work with. He was reliable, friendly, and always willing to go the extra mile to help us. His local knowledge and attention to detail made things much easier for us. We really appreciated his help and would gladly recommend him to anyone moving to Panama.',
  },
  {
    name: 'James Carter',
    avatar: 'JC',
    rating: 5,
    date: '5 months ago',
    text: 'George was a great help during our time in Panama. He was very attentive, reliable, and always willing to help whenever we needed something. Having someone like him available made our experience much easier and more comfortable.',
  },
  {
    name: 'Linda Williams',
    avatar: 'LW',
    rating: 5,
    date: '5 months ago',
    text: 'We really enjoyed working with George. He was friendly, knowledgeable, and very easy to communicate with. He helped us with several things during our relocation and always made sure everything was taken care of. We would definitely recommend him.',
  },
  {
    name: 'Sophie Martin',
    avatar: 'SO',
    rating: 5,
    date: '6 months ago',
    text: 'Eloise was wonderful to work with. She was always kind, helpful, and attentive to the details. She made us feel welcome and was always willing to assist whenever we had questions. We truly appreciated her support throughout our experience in Panama.',
  },
  {
    name: 'Michael',
    avatar: 'MI',
    rating: 5,
    date: '7 months ago',
    text: 'Moving to another country can be overwhelming, but working with Moisés and his team made the process much simpler. They were always willing to help and provided guidance throughout the process. I especially appreciated how easy it was to communicate with them and how quickly they responded.',
  },
];

const reviews = ALL_REVIEWS;
---

<!-- Reviews Carousel -->
<section class="py-16 md:py-20 bg-white overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-10">
      <div>
        <!-- Google logo + rating badge -->
        <div class="flex items-center gap-3 mb-3">
          <!-- Google "G" logo SVG -->
          <svg width="22" height="22" viewBox="0 0 24 24" aria-label="Google" role="img">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
          </svg>
          <span class="text-sm font-semibold text-slate">{l.badge}</span>
          <!-- 5 stars -->
          <div class="flex gap-0.5" aria-label="5 stars">
            {[1,2,3,4,5].map(() => (
              <svg width="14" height="14" viewBox="0 0 24 24" fill="#F9AB00" aria-hidden="true">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            ))}
          </div>
        </div>
        <h2 class="font-serif text-2xl md:text-3xl text-slate">{l.heading}</h2>
        <p class="text-slate-mid text-sm mt-1">{l.subtext}</p>
      </div>
      <!-- Arrows -->
      <div class="flex gap-2 flex-shrink-0">
        <button
          id="reviews-prev"
          aria-label="Previous reviews"
          class="w-10 h-10 rounded-full border border-jade/20 flex items-center justify-center text-slate-mid hover:border-jade hover:text-jade transition-colors"
        >
          ←
        </button>
        <button
          id="reviews-next"
          aria-label="Next reviews"
          class="w-10 h-10 rounded-full border border-jade/20 flex items-center justify-center text-slate-mid hover:border-jade hover:text-jade transition-colors"
        >
          →
        </button>
      </div>
    </div>

    <!-- Carousel track -->
    <div class="relative overflow-hidden">
      <div
        id="reviews-track"
        class="flex gap-5 transition-transform duration-400 ease-in-out"
        style="will-change: transform;"
      >
        {reviews.map(r => (
          <article
            class="flex-shrink-0 w-[300px] sm:w-[340px] bg-white rounded-2xl border border-slate/10 shadow-sm p-6 flex flex-col gap-4"
            aria-label={`Review by ${r.name}`}
          >
            <!-- Top row: avatar + name + verified -->
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-jade/10 text-jade font-semibold text-sm flex items-center justify-center flex-shrink-0 select-none">
                {r.avatar ?? r.name.slice(0, 2).toUpperCase()}
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-1.5 flex-wrap">
                  <p class="font-semibold text-slate text-sm truncate">{r.name}</p>
                  <!-- Verified checkmark -->
                  <span class="inline-flex items-center gap-1 text-xs text-jade/70">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/>
                    </svg>
                    {l.verified}
                  </span>
                </div>
                <p class="text-xs text-slate-mid mt-0.5">{r.date}</p>
              </div>
              <!-- Google G micro -->
              <svg width="16" height="16" viewBox="0 0 24 24" class="flex-shrink-0 opacity-60" aria-hidden="true">
                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"/>
                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
              </svg>
            </div>

            <!-- Stars -->
            <div class="flex gap-0.5" aria-label={`${r.rating} out of 5 stars`}>
              {Array.from({ length: 5 }).map((_, i) => (
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill={i < r.rating ? '#F9AB00' : '#E0E0E0'}
                  aria-hidden="true"
                >
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              ))}
            </div>

            <!-- Review text -->
            <p class="text-slate-mid text-sm leading-relaxed line-clamp-4 flex-1">{r.text}</p>
          </article>
        ))}
      </div>
    </div>

  </div>
</section>

<script>
  const track   = document.getElementById('reviews-track')  as HTMLElement | null;
  const prevBtn = document.getElementById('reviews-prev')   as HTMLButtonElement | null;
  const nextBtn = document.getElementById('reviews-next')   as HTMLButtonElement | null;
  if (!track || !prevBtn || !nextBtn) throw new Error('ReviewsCarousel: missing elements');

  const CARD_W = 340 + 20; // card width + gap
  let offset = 0;

  function clampedOffset(raw: number) {
    const maxOffset = Math.max(0, track.scrollWidth - track.parentElement!.clientWidth);
    return Math.max(0, Math.min(raw, maxOffset));
  }

  nextBtn.addEventListener('click', () => {
    offset = clampedOffset(offset + CARD_W * 2);
    track.style.transform = `translateX(-${offset}px)`;
  });

  prevBtn.addEventListener('click', () => {
    offset = clampedOffset(offset - CARD_W * 2);
    track.style.transform = `translateX(-${offset}px)`;
  });

  // Touch / swipe support
  let startX = 0;
  track.addEventListener('touchstart', e => { startX = e.touches[0].clientX; }, { passive: true });
  track.addEventListener('touchend', e => {
    const delta = startX - e.changedTouches[0].clientX;
    if (Math.abs(delta) > 50) {
      offset = clampedOffset(offset + (delta > 0 ? CARD_W : -CARD_W));
      track.style.transform = `translateX(-${offset}px)`;
    }
  }, { passive: true });
</script>

<style>
  .line-clamp-4 {
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .transition-transform { transition-property: transform; }
  .duration-400 { transition-duration: 400ms; }
</style>
