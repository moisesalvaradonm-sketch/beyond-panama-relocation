  function buildFormOptions(containerId, name, options, isCheck) {
    const container = document.getElementById(containerId);
    if (!container) return;
    container.innerHTML = '';
    options.forEach(opt => {
      const lbl = document.createElement('label');
      lbl.className = 'bpr-option';
      const inp = document.createElement('input');
      inp.type = isCheck ? 'checkbox' : 'radio';
      inp.name = name;
      inp.value = opt;
      const span = document.createTextNode(opt);
      lbl.appendChild(inp); lbl.appendChild(span);
      container.appendChild(lbl);
    });
  }

  function initForm() {
    const f = t.form;
    setText('bprf-title', f.title);
