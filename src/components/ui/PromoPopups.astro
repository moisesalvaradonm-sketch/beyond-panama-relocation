  if (propCta) {
    propCta.addEventListener('click', () => {
      hidePopup('bpr-popup-prop', () => {
        const overlay = document.getElementById('bpr-form-overlay');
        if (overlay) { overlay.classList.add('bpr-visible'); document.body.style.overflow = 'hidden'; }
      });
    });
  }

  /* ── Form close ── */
  function closeForm() {
    const overlay = document.getElementById('bpr-form-overlay');
    if (overlay) { overlay.classList.remove('bpr-visible'); }
    document.body.style.overflow = '';
  }
  const formClose = document.getElementById('bpr-form-close');
  if (formClose) formClose.addEventListener('click', closeForm);
  const overlay = document.getElementById('bpr-form-overlay');
  if (overlay) overlay.addEventListener('click', e => { if (e.target === overlay) closeForm(); });

  /* ── Form submit ── */
  const form = document.getElementById('bpr-prop-form');
  if (form) {
    form.addEventListener('submit', async function(e) {
      e.preventDefault();
      const btn = document.getElementById('bprf-submit-btn');
      if (btn) { btn.disabled = true; btn.textContent = t.form.sending; }

      const fd = new FormData(this);
      const message = [
        'Consulta de propiedad / Property inquiry',
        'Objetivo: ' + (fd.get('objetivo') || '-'),
        'Tipo: ' + (fd.getAll('tipo').join(', ') || '-'),
        'Zona: ' + (fd.get('zona') || '-'),
        'Presupuesto: ' + (fd.get('presupuesto') || '-'),
        'Plazo: ' + (fd.get('plazo') || '-'),
      ].join('\n');

      const payload = new FormData();
      payload.append('name', fd.get('name') || '');
      payload.append('email', fd.get('email') || '');
      payload.append('whatsapp', fd.get('whatsapp') || '');
      payload.append('message', message);
      payload.append('source', 'property-popup');

      try {
        const res = await fetch('/api/property-inquiry.php', { method: 'POST', body: payload });
        if (res.ok) {
          this.style.display = 'none';
          const s = document.getElementById('bpr-success');
          if (s) s.style.display = 'block';
        } else throw new Error();
      } catch {
        const errEl = document.getElementById('bpr-error');
        if (errEl) errEl.style.display = 'block';
        if (btn) { btn.disabled = false; btn.textContent = t.form.submit; }
      }
    });
  }

  /* ── Init ── */
  initForm();

  /* ═══════════════════════════════════════════════════════════════
     SPLIT POPUP — newsletter / lead capture
  ═══════════════════════════════════════════════════════════════ */
  const splitCopy = {
    es: {
      eyebrow: '📩 Registro exclusivo',
      pct: '25%',
      de: 'DE',
      word1: 'DESCUENTO',
      word2: 'INMEDIATO',
      caption: 'Al comenzar tu proceso de residencia en Panamá con uno de nuestros profesionales especializados.',
      namePh: 'Tu nombre',
      emailPh: 'Tu email',
      consent: 'Me gustaría recibir información sobre reubicación a Panamá. Política de privacidad aplicable.',
      submit: 'QUIERO MI DESCUENTO',
      sending: 'Enviando…',
      sTitle: '¡Listo!',
      sBody: 'Te hemos enviado la información a tu correo. ¡Nos pondremos en contacto contigo pronto!',
      badge: '📍 Panamá · Beyond Panama Relocation',
    },
    en: {
      eyebrow: '📩 Exclusive access',
      pct: '25%',
      de: 'OFF',
      word1: 'INSTANT',
      word2: 'DISCOUNT',
      caption: 'When you start your Panama residency process with one of our specialized professionals.',
      namePh: 'Your name',
      emailPh: 'Your email',
      consent: 'I\'d like to receive information about relocating to Panama. Privacy policy applies.',
      submit: 'CLAIM MY DISCOUNT',
      sending: 'Sending…',
      sTitle: 'You\'re in!',
      sBody: 'We\'ve sent information to your email. We\'ll be in touch with you soon!',
      badge: '📍 Panama · Beyond Panama Relocation',
    },
    fr: {
      eyebrow: '📩 Accès exclusif',
      pct: '25%',
      de: 'DE',
      word1: 'RÉDUCTION',
      word2: 'IMMÉDIATE',
      caption: 'En commençant votre processus de résidence au Panama avec l\'un de nos professionnels spécialisés.',
      namePh: 'Votre prénom',
      emailPh: 'Votre email',
      consent: 'Je souhaite recevoir des informations sur la relocation au Panama. Politique de confidentialité applicable.',
      submit: 'OBTENIR MA RÉDUCTION',
      sending: 'Envoi…',
      sTitle: 'C\'est fait !',
      sBody: 'Nous vous avons envoyé les informations par email. Nous vous contacterons bientôt !',
      badge: '📍 Panama · Beyond Panama Relocation',
    },
  };

  const sc = splitCopy[lang] || splitCopy['es'];

  function setId(id, val) { const el = document.getElementById(id); if (el) el.textContent = val; }
  function setAttr(id, attr, val) { const el = document.getElementById(id); if (el) el[attr] = val; }

  // Fill text
  setId('bpr-split-eyebrow', sc.eyebrow);
  setId('bpr-split-pct', sc.pct);
  setId('bpr-split-de', sc.de);
  setId('bpr-split-word1', sc.word1);
  setId('bpr-split-word2', sc.word2);
  setId('bpr-split-caption', sc.caption);
  setAttr('bpr-sn', 'placeholder', sc.namePh);
  setAttr('bpr-se', 'placeholder', sc.emailPh);
  setId('bpr-split-consent-txt', sc.consent);
  setId('bpr-split-submit', sc.submit);
  setId('bpr-ss-title', sc.sTitle);
  setId('bpr-ss-body', sc.sBody);
  setId('bpr-split-photo-badge', sc.badge);

  // Open / close
  const splitWrap = document.getElementById('bpr-split-wrap');
  function openSplit() { if (splitWrap) { splitWrap.classList.add('bpr-split-open'); document.body.style.overflow = 'hidden'; } }
  function closeSplit() {
    if (splitWrap) { splitWrap.classList.remove('bpr-split-open'); document.body.style.overflow = ''; }
    try { localStorage.setItem('bpr-split-seen', Date.now().toString()); } catch(e) {}
  }

  // Close button
  const splitCloseBtn = document.getElementById('bpr-split-close');
  if (splitCloseBtn) splitCloseBtn.addEventListener('click', closeSplit);
  if (splitWrap) splitWrap.addEventListener('click', e => { if (e.target === splitWrap) closeSplit(); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeSplit(); });

  // Show logic: only if not seen in the last 14 days and not already subscribed
  function shouldShowSplit() {
    try {
      if (localStorage.getItem('bpr-nl-done')) return false;
      const seen = parseInt(localStorage.getItem('bpr-split-seen') || '0', 10);
      const FOURTEEN_DAYS = 14 * 24 * 60 * 60 * 1000;
      if (seen && Date.now() - seen < FOURTEEN_DAYS) return false;
    } catch(e) {}
    return true;
  }

  // Delay: show after 18s (after the toast popups have appeared)
  if (shouldShowSplit()) {
    setTimeout(openSplit, 18000);
  }

  // Form submit → subscribe to newsletter
  const splitForm = document.getElementById('bpr-split-form');
  if (splitForm) {
    splitForm.addEventListener('submit', async function(e) {
      e.preventDefault();
      const consent = document.getElementById('bpr-sc');
      if (consent && !consent.checked) { consent.reportValidity(); return; }

      const nameVal  = (document.getElementById('bpr-sn')?.value || '').trim();
      const emailVal = (document.getElementById('bpr-se')?.value || '').trim();
      if (!nameVal || !emailVal) return;

      const btn = document.getElementById('bpr-split-submit');
      if (btn) { btn.disabled = true; btn.textContent = sc.sending; }

      try {
        await fetch('/api/property-inquiry.php?t=nl', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: emailVal }),
        });
        // Always show success regardless of response
        try { localStorage.setItem('bpr-nl-done', '1'); } catch(e) {}
        this.style.display = 'none';
        const suc = document.getElementById('bpr-split-success');
        if (suc) suc.style.display = 'block';
        document.getElementById('bpr-split-caption').style.display = 'none';
        setTimeout(closeSplit, 3500);
      } catch {
        if (btn) { btn.disabled = false; btn.textContent = sc.submit; }
      }
    });
  }
})();
</script>
