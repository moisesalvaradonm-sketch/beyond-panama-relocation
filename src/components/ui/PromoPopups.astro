---
// Global premium pop-ups — ES / EN / FR, all pages
---

<style is:global>
/* ══════════════════════════════════════════════════════════════
   SPLIT POPUP — centrado, foto izquierda + formulario derecha
══════════════════════════════════════════════════════════════ */
#bpr-split-wrap {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 9600;
  background: rgba(4, 10, 18, 0.78);
  backdrop-filter: blur(5px);
  align-items: center;
  justify-content: center;
  padding: 16px;
}
#bpr-split-wrap.bpr-split-open { display: flex; }

@keyframes bpr-split-in {
  from { opacity: 0; transform: scale(0.94) translateY(16px); }
  to   { opacity: 1; transform: scale(1)    translateY(0);    }
}
#bpr-split-card {
  display: grid;
  grid-template-columns: 1fr 1fr;
  width: min(860px, 100%);
  max-height: 90vh;
  border-radius: 20px;
  overflow: hidden;
  box-shadow: 0 40px 120px rgba(0,0,0,0.7), 0 8px 32px rgba(0,0,0,0.4);
  animation: bpr-split-in 0.5s cubic-bezier(0.22, 1, 0.36, 1) forwards;
}

/* ── Left: photo ── */
#bpr-split-photo {
  position: relative;
  min-height: 500px;
  background: #0a1a26;
  overflow: hidden;
}
#bpr-split-photo img {
  width: 100%; height: 100%;
  object-fit: cover;
  display: block;
  filter: brightness(0.82);
}
#bpr-split-photo::after {
  content: '';
  position: absolute; inset: 0;
  background: linear-gradient(160deg, rgba(11,29,42,0.15) 0%, rgba(11,29,42,0.55) 100%);
}
#bpr-split-photo-badge {
  position: absolute; bottom: 24px; left: 20px; right: 20px; z-index: 2;
  font-size: 0.62rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase;
  color: rgba(255,255,255,0.6);
}

/* ── Right: form ── */
#bpr-split-form-side {
  background: #0B1D2A;
  padding: 44px 36px 32px;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow-y: auto;
}
#bpr-split-close {
  position: absolute; top: 14px; right: 14px;
  width: 30px; height: 30px; border-radius: 50%;
  background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.12);
  color: rgba(255,255,255,0.5); font-size: 13px; cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  transition: background 0.2s, color 0.2s; line-height: 1;
}
#bpr-split-close:hover { background: rgba(255,255,255,0.18); color: white; }

/* Big offer typography */
#bpr-split-eyebrow {
  font-size: 0.62rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase;
  color: #5DBDAC; margin-bottom: 14px;
}
#bpr-split-offer-block {
  margin-bottom: 6px;
  line-height: 1;
}
#bpr-split-pct {
  display: block;
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-size: clamp(4rem, 8vw, 6.5rem);
  font-weight: 700;
  color: #fff;
  line-height: 0.9;
  letter-spacing: -0.02em;
}
#bpr-split-de {
  display: inline-block;
  font-size: 0.7rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
  color: rgba(255,255,255,0.45); margin-top: 4px;
}
#bpr-split-word1 {
  display: block;
  font-size: clamp(1.4rem, 3vw, 2rem);
  font-weight: 900; letter-spacing: 0.05em; text-transform: uppercase;
  color: #fff; line-height: 1.05;
}
#bpr-split-word2 {
  display: block;
  font-size: clamp(1.1rem, 2.5vw, 1.55rem);
  font-weight: 900; letter-spacing: 0.08em; text-transform: uppercase;
  color: rgba(255,255,255,0.75); line-height: 1.1; margin-top: 2px;
}
#bpr-split-caption {
  font-size: 0.73rem; color: rgba(255,255,255,0.45); margin: 14px 0 22px;
  line-height: 1.55;
}

/* Form inputs */
#bpr-split-form .bpr-si {
  display: block; width: 100%; box-sizing: border-box;
  padding: 11px 0; margin-bottom: 2px;
  background: transparent;
  border: none; border-bottom: 1px solid rgba(255,255,255,0.18);
  color: #fff; font-size: 0.83rem;
  outline: none; transition: border-color 0.2s;
}
#bpr-split-form .bpr-si::placeholder { color: rgba(255,255,255,0.3); }
#bpr-split-form .bpr-si:focus { border-bottom-color: #2D7D6F; }
.bpr-si-wrap { margin-bottom: 14px; }

#bpr-split-consent {
  display: flex; gap: 10px; align-items: flex-start;
  margin: 18px 0 20px;
}
#bpr-split-consent input { accent-color: #2D7D6F; margin-top: 2px; flex-shrink: 0; }
#bpr-split-consent span { font-size: 0.65rem; color: rgba(255,255,255,0.35); line-height: 1.5; }

#bpr-split-submit {
  width: 100%; padding: 14px; border: none; border-radius: 8px;
  font-size: 0.78rem; font-weight: 900; letter-spacing: 0.1em; text-transform: uppercase;
  background: linear-gradient(135deg, #2D7D6F, #3AADA0); color: white;
  cursor: pointer; box-shadow: 0 8px 28px rgba(45,125,111,0.4);
  transition: opacity 0.2s, transform 0.15s;
}
#bpr-split-submit:hover { opacity: 0.92; transform: translateY(-1px); }
#bpr-split-submit:disabled { opacity: 0.55; transform: none; }

#bpr-split-success {
  display: none;
  text-align: center;
  padding: 24px 0;
}
#bpr-split-success .bpr-s-icon { font-size: 2.2rem; margin-bottom: 12px; }
#bpr-split-success h3 { font-family: 'Cormorant Garamond',Georgia,serif; font-size: 1.4rem; color: white; margin: 0 0 8px; }
#bpr-split-success p { font-size: 0.78rem; color: rgba(255,255,255,0.5); line-height: 1.6; margin: 0; }

/* Mobile: stack vertically */
@media (max-width: 600px) {
  #bpr-split-card { grid-template-columns: 1fr; }
  #bpr-split-photo { min-height: 200px; max-height: 220px; }
  #bpr-split-form-side { padding: 30px 24px 24px; }
  #bpr-split-pct { font-size: 4rem; }
}</style>

<!-- ── SPLIT POPUP (foto + formulario) ─────────────────────────── -->
<div id="bpr-split-wrap" role="dialog" aria-modal="true" aria-labelledby="bpr-split-word1">
  <div id="bpr-split-card">
    <!-- Left: photo -->
    <div id="bpr-split-photo">
      <img src="/img/Panama-D-01a.png" alt="Panama City" loading="lazy" />
      <p id="bpr-split-photo-badge">📍 Panamá · Beyond Panama Relocation</p>
    </div>

    <!-- Right: form -->
    <div id="bpr-split-form-side">
      <button id="bpr-split-close" aria-label="Cerrar">✕</button>

      <p id="bpr-split-eyebrow"></p>
      <div id="bpr-split-offer-block">
        <span id="bpr-split-pct"></span>
        <span id="bpr-split-de"></span>
        <span id="bpr-split-word1"></span>
        <span id="bpr-split-word2"></span>
      </div>
      <p id="bpr-split-caption"></p>

      <div id="bpr-split-success">
        <div class="bpr-s-icon">✅</div>
        <h3 id="bpr-ss-title"></h3>
        <p id="bpr-ss-body"></p>
      </div>

      <form id="bpr-split-form" novalidate>
        <div class="bpr-si-wrap">
          <input class="bpr-si" id="bpr-sn" name="name" type="text" required autocomplete="given-name" />
        </div>
        <div class="bpr-si-wrap">
          <input class="bpr-si" id="bpr-se" name="email" type="email" required autocomplete="email" />
        </div>
        <div id="bpr-split-consent">
          <input type="checkbox" id="bpr-sc" required />
          <span id="bpr-split-consent-txt"></span>
        </div>
        <button type="submit" id="bpr-split-submit"></button>
      </form>
    </div>
  </div>
</div>

<style is:global>
  /* ── Popup base ─────────────────────────────────────────────── */
  .bpr-popup {
    display: none;
    position: fixed;
    bottom: 28px;
    right: 28px;
    z-index: 9200;
    width: min(420px, calc(100vw - 32px));
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.07);
    box-shadow: 0 28px 72px rgba(0,0,0,0.55), 0 6px 20px rgba(0,0,0,0.3);
  }
  .bpr-popup-inner {
    padding: 32px 28px 24px;
    position: relative;
  }
  .bpr-popup.bpr-visa   .bpr-popup-inner { background: linear-gradient(148deg, #0B1D2A 0%, #0E2535 60%, #0F2A30 100%); border-top: 3px solid #2D7D6F; }
  .bpr-popup.bpr-prop   .bpr-popup-inner { background: linear-gradient(148deg, #120E00 0%, #1E1A06 60%, #16130A 100%); border-top: 3px solid #C4A96D; }

  .bpr-close {
    position: absolute; top: 14px; right: 14px;
    width: 30px; height: 30px; border-radius: 50%;
    background: rgba(255,255,255,0.09); border: 1px solid rgba(255,255,255,0.12);
    color: rgba(255,255,255,0.6); font-size: 14px; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: background 0.2s, color 0.2s;
  }
  .bpr-close:hover { background: rgba(255,255,255,0.18); color: white; }

  .bpr-tag {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 0.65rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
    padding: 4px 10px; border-radius: 999px; margin-bottom: 14px;
  }
  .bpr-visa  .bpr-tag { background: rgba(45,125,111,0.2); color: #5DBDAC; border: 1px solid rgba(45,125,111,0.3); }
  .bpr-prop  .bpr-tag { background: rgba(196,169,109,0.15); color: #D4BA82; border: 1px solid rgba(196,169,109,0.25); }

  .bpr-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.35rem; font-weight: 600; color: #fff;
    line-height: 1.28; margin: 0 28px 6px 0;
  }
  .bpr-subtitle {
    font-size: 0.78rem; font-weight: 600; margin: 0 0 12px;
  }
  .bpr-visa  .bpr-subtitle { color: #5DBDAC; }
  .bpr-prop  .bpr-subtitle { color: #D4BA82; }

  .bpr-body {
    font-size: 0.77rem; color: rgba(255,255,255,0.55);
    line-height: 1.6; margin: 0 0 14px;
  }
  .bpr-bullets { list-style: none; padding: 0; margin: 0 0 20px; display: flex; flex-direction: column; gap: 7px; }
  .bpr-bullet { display: flex; align-items: flex-start; gap: 8px; font-size: 0.77rem; color: rgba(255,255,255,0.8); line-height: 1.4; }
  .bpr-bullet-dot {
    flex-shrink: 0; margin-top: 1px;
    width: 16px; height: 16px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center; font-size: 9px;
  }
  .bpr-visa  .bpr-bullet-dot { background: rgba(45,125,111,0.25); color: #5DBDAC; }
  .bpr-prop  .bpr-bullet-dot { background: rgba(196,169,109,0.2); color: #D4BA82; }

  .bpr-cta {
    display: block; width: 100%; text-align: center; border: none; cursor: pointer;
    font-size: 0.78rem; font-weight: 700; letter-spacing: 0.06em;
    padding: 13px 20px; border-radius: 10px; text-decoration: none;
    transition: opacity 0.2s, transform 0.15s;
  }
  .bpr-cta:hover { opacity: 0.9; transform: translateY(-1px); }
  .bpr-cta:active { transform: translateY(0); }
  .bpr-visa  .bpr-cta { background: linear-gradient(135deg, #2D7D6F, #3AADA0); color: white; box-shadow: 0 6px 24px rgba(45,125,111,0.4); }
  .bpr-prop  .bpr-cta { background: linear-gradient(135deg, #C4A96D, #D4BA82); color: #12100A; box-shadow: 0 6px 24px rgba(196,169,109,0.3); }

  .bpr-fine {
    font-size: 0.62rem; color: rgba(255,255,255,0.28);
    line-height: 1.5; margin: 14px 0 0; text-align: center;
  }
  .bpr-divider { height: 1px; background: rgba(255,255,255,0.07); margin: 18px 0; }

  /* Entrance animation */
  @keyframes bpr-in {
    from { opacity: 0; transform: translateY(20px) scale(0.97); }
    to   { opacity: 1; transform: translateY(0)    scale(1);    }
  }
  .bpr-popup.bpr-visible {
    display: block;
    animation: bpr-in 0.45s cubic-bezier(0.34, 1.4, 0.64, 1) forwards;
  }
  @keyframes bpr-out {
    to { opacity: 0; transform: translateY(12px) scale(0.97); }
  }
  .bpr-popup.bpr-hiding {
    animation: bpr-out 0.28s ease-in forwards;
  }

  /* Mobile: bottom sheet */
  @media (max-width: 500px) {
    .bpr-popup {
      bottom: 0 !important; left: 0 !important; right: 0 !important;
      width: 100% !important; border-radius: 20px 20px 0 0 !important;
    }
  }

  /* ── Form modal ─────────────────────────────────────────────── */
  #bpr-form-overlay {
    display: none; position: fixed; inset: 0; z-index: 9800;
    background: rgba(8,16,26,0.8); backdrop-filter: blur(6px);
    overflow-y: auto; padding: 24px 16px;
  }
  #bpr-form-overlay.bpr-visible { display: block; }
  .bpr-form-card {
    background: #fff; border-radius: 16px;
    max-width: 520px; margin: 0 auto; overflow: hidden;
    box-shadow: 0 24px 80px rgba(0,0,0,0.5);
  }
  .bpr-form-head {
    background: linear-gradient(135deg, #0B1D2A, #0E2A22);
    padding: 28px 28px 22px; position: relative;
    border-bottom: 3px solid #2D7D6F;
  }
  .bpr-form-head-title { font-family: 'Cormorant Garamond',Georgia,serif; font-size: 1.25rem; color: white; margin: 0 0 6px; }
  .bpr-form-head-sub { font-size: 0.77rem; color: rgba(255,255,255,0.6); margin: 0; line-height: 1.5; }
  #bpr-form-close {
    position: absolute; top: 14px; right: 14px;
    width: 30px; height: 30px; border-radius: 50%;
    background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.15);
    color: rgba(255,255,255,0.7); font-size: 14px; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: background 0.2s;
  }
  #bpr-form-close:hover { background: rgba(255,255,255,0.2); }
  .bpr-form-body { padding: 24px; }
  .bpr-field-group { margin-bottom: 20px; }
  .bpr-field-legend {
    display: block; font-size: 0.78rem; font-weight: 700; color: #0B1D2A;
    margin-bottom: 10px; letter-spacing: 0.01em;
  }
  .bpr-radio-grid { display: flex; flex-direction: column; gap: 6px; }
  .bpr-check-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
  .bpr-option {
    display: flex; align-items: center; gap: 9px;
    font-size: 0.79rem; color: #2D3748; cursor: pointer;
    padding: 7px 10px; border-radius: 8px; border: 1px solid #E2E8EE;
    transition: border-color 0.15s, background 0.15s;
  }
  .bpr-option:hover { border-color: #2D7D6F; background: #f0faf8; }
  .bpr-option input { accent-color: #2D7D6F; }
  .bpr-input-wrap { margin-bottom: 12px; }
  .bpr-input-label { display: block; font-size: 0.78rem; font-weight: 700; color: #0B1D2A; margin-bottom: 5px; }
  .bpr-input {
    width: 100%; padding: 10px 13px; border: 1.5px solid #D1D9E0;
    border-radius: 8px; font-size: 0.82rem; color: #1a1a2e;
    box-sizing: border-box; transition: border-color 0.2s, box-shadow 0.2s;
    outline: none;
  }
  .bpr-input:focus { border-color: #2D7D6F; box-shadow: 0 0 0 3px rgba(45,125,111,0.12); }
  .bpr-submit {
    width: 100%; padding: 14px; border: none; border-radius: 10px; cursor: pointer;
    font-size: 0.82rem; font-weight: 700; letter-spacing: 0.06em;
    background: linear-gradient(135deg, #2D7D6F, #3AADA0); color: white;
    box-shadow: 0 6px 24px rgba(45,125,111,0.35);
    transition: opacity 0.2s, transform 0.15s;
  }
  .bpr-submit:hover { opacity: 0.9; transform: translateY(-1px); }
  .bpr-submit:disabled { opacity: 0.6; transform: none; }
  .bpr-form-fine {
    font-size: 0.65rem; color: #9AACB8; margin: 14px 0 0; text-align: center; line-height: 1.5;
  }
  .bpr-form-success {
    display: none; text-align: center; padding: 32px 20px;
    background: linear-gradient(135deg, #f0faf7, #e8f6f2);
    border-radius: 12px; margin-bottom: 8px;
  }
  .bpr-form-success .icon { font-size: 2.5rem; margin-bottom: 12px; }
  .bpr-form-success h3 { font-family: 'Cormorant Garamond',Georgia,serif; font-size: 1.3rem; color: #0B1D2A; margin: 0 0 8px; }
  .bpr-form-success p  { font-size: 0.8rem; color: #4A6070; margin: 0; line-height: 1.6; }
  .bpr-form-error {
    display: none; text-align: center; padding: 12px 16px;
    background: #FFF0EE; border-radius: 8px; border: 1px solid #FECEC5; margin-bottom: 8px;
  }
  .bpr-form-error p { font-size: 0.78rem; color: #C0392B; margin: 0; }
  .bpr-sep { height: 1px; background: #EDF0F4; margin: 18px 0; }
</style>

<!-- ── VISA POP-UP ──────────────────────────────────────────────── -->
<div id="bpr-popup-visa" class="bpr-popup bpr-visa" role="dialog" aria-modal="true">
  <div class="bpr-popup-inner">
    <button class="bpr-close" id="bpr-visa-close" aria-label="Cerrar">✕</button>
    <span class="bpr-tag" id="bpr-v-tag">●</span>
    <p class="bpr-title" id="bpr-v-title"></p>
    <p class="bpr-subtitle" id="bpr-v-subtitle"></p>
    <p class="bpr-body" id="bpr-v-body"></p>
    <ul class="bpr-bullets" id="bpr-v-bullets"></ul>
    <a class="bpr-cta" id="bpr-v-cta" href="#" target="_blank" rel="noopener"></a>
    <p class="bpr-fine" id="bpr-v-fine"></p>
  </div>
</div>

<!-- ── PROPERTY POP-UP ─────────────────────────────────────────── -->
<div id="bpr-popup-prop" class="bpr-popup bpr-prop" role="dialog" aria-modal="true">
  <div class="bpr-popup-inner">
    <button class="bpr-close" id="bpr-prop-close" aria-label="Cerrar">✕</button>
    <span class="bpr-tag" id="bpr-p-tag">●</span>
    <p class="bpr-title" id="bpr-p-title"></p>
    <p class="bpr-subtitle" id="bpr-p-subtitle"></p>
    <p class="bpr-body" id="bpr-p-body"></p>
    <ul class="bpr-bullets" id="bpr-p-bullets"></ul>
    <button class="bpr-cta" id="bpr-p-cta"></button>
    <p class="bpr-fine" id="bpr-p-fine"></p>
  </div>
</div>

<!-- ── PROPERTY FORM OVERLAY ───────────────────────────────────── -->
<div id="bpr-form-overlay">
  <div class="bpr-form-card">
    <div class="bpr-form-head">
      <button id="bpr-form-close" aria-label="Cerrar">✕</button>
      <p class="bpr-form-head-title" id="bprf-title">🏡 Cuéntanos qué propiedad estás buscando</p>
      <p class="bpr-form-head-sub" id="bprf-sub">Completa este formulario y te conectaremos con un profesional inmobiliario que pueda mostrarte opciones según tus necesidades.</p>
    </div>
    <div class="bpr-form-body">
      <div class="bpr-form-success" id="bpr-success">
        <div class="icon">✅</div>
        <h3 id="bprf-s-title">¡Listo!</h3>
        <p id="bprf-s-body">Recibimos tu solicitud. Revisaremos lo que estás buscando y te conectaremos con un profesional inmobiliario que pueda ayudarte.</p>
      </div>
      <div class="bpr-form-error" id="bpr-error">
        <p id="bprf-e-msg">Hubo un problema. Por favor inténtalo de nuevo o escríbenos por WhatsApp.</p>
      </div>

      <form id="bpr-prop-form">
        <div class="bpr-field-group">
          <span class="bpr-field-legend" id="bprf-q1"></span>
          <div class="bpr-radio-grid" id="bprf-q1-opts"></div>
        </div>
        <div class="bpr-sep"></div>
        <div class="bpr-field-group">
          <span class="bpr-field-legend" id="bprf-q2"></span>
          <div class="bpr-check-grid" id="bprf-q2-opts"></div>
        </div>
        <div class="bpr-sep"></div>
        <div class="bpr-field-group">
          <span class="bpr-field-legend" id="bprf-q3"></span>
          <div class="bpr-radio-grid" id="bprf-q3-opts"></div>
        </div>
        <div class="bpr-sep"></div>
        <div class="bpr-field-group">
          <span class="bpr-field-legend" id="bprf-q4"></span>
          <div class="bpr-radio-grid" id="bprf-q4-opts"></div>
        </div>
        <div class="bpr-sep"></div>
        <div class="bpr-field-group">
          <span class="bpr-field-legend" id="bprf-q5"></span>
          <div class="bpr-radio-grid" id="bprf-q5-opts"></div>
        </div>
        <div class="bpr-sep"></div>
        <div class="bpr-input-wrap">
          <label class="bpr-input-label" for="bprf-name" id="bprf-l-name"></label>
          <input class="bpr-input" id="bprf-name" name="name" type="text" required />
        </div>
        <div class="bpr-input-wrap">
          <label class="bpr-input-label" for="bprf-wa" id="bprf-l-wa"></label>
          <input class="bpr-input" id="bprf-wa" name="whatsapp" type="tel" required placeholder="+1 555 000 0000" />
        </div>
        <div class="bpr-input-wrap">
