  function rand(arr) { return arr[Math.floor(Math.random() * arr.length)]; }
  function getLS(k) { try { return localStorage.getItem(k); } catch(e) { return null; } }
  function setLS(k, v) { try { localStorage.setItem(k, v); } catch(e) {} }

  function setText(id, val) { const el = document.getElementById(id); if (el) el.textContent = val; }

  function fillBullets(ulId, items, variant) {
    const ul = document.getElementById(ulId);
    if (!ul) return;
    ul.innerHTML = '';
    ul.style.display = items.length ? 'flex' : 'none';
    items.forEach(b => {
      const li = document.createElement('li');
      li.className = 'bpr-bullet';
      const dot = document.createElement('span');
      dot.className = 'bpr-bullet-dot';
      dot.textContent = '✓';
      const txt = document.createTextNode(b);
      li.appendChild(dot); li.appendChild(txt);
      ul.appendChild(li);
    });
  }

  function showPopup(id) {
    const el = document.getElementById(id);
    if (!el) return;
    el.classList.remove('bpr-hiding');
    el.classList.add('bpr-visible');
  }
  function hidePopup(id, cb) {
    const el = document.getElementById(id);
    if (!el) return;
    el.classList.add('bpr-hiding');
    el.classList.remove('bpr-visible');
    setTimeout(() => { el.classList.remove('bpr-hiding', 'bpr-visible'); el.style.display = 'none'; if (cb) cb(); }, 300);
  }

