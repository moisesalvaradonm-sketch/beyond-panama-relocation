  /* ═══════════════════════════════════════════════════════════════
     SCHEDULING LOGIC
  ═══════════════════════════════════════════════════════════════ */
  const SK_LAST_TYPE = 'bpr-last-type';
  const SK_LAST_TIME = 'bpr-last-time';
  const THREE_MIN = 3 * 60 * 1000;
  const now = Date.now();

  const lastType = getLS(SK_LAST_TYPE);
  const lastTime = parseInt(getLS(SK_LAST_TIME) || '0', 10);

  let firstDelay, firstFn, secondFn;

  function showVisa() { loadVisaVariant(); showPopup('bpr-popup-visa'); setLS(SK_LAST_TYPE, 'visa'); setLS(SK_LAST_TIME, Date.now().toString()); }
  function showProp() { loadPropVariant(); showPopup('bpr-popup-prop'); setLS(SK_LAST_TYPE, 'prop'); setLS(SK_LAST_TIME, Date.now().toString()); }

  if (!lastType) {
    firstDelay = 5000;
    if (Math.random() < 0.5) { firstFn = showVisa; secondFn = showProp; }
    else                      { firstFn = showProp; secondFn = showVisa; }
  } else {
    const elapsed = now - lastTime;
    const remaining = Math.max(3000, THREE_MIN - elapsed);
    firstDelay = remaining;
    firstFn = lastType === 'visa' ? showProp : showVisa;
    secondFn = lastType === 'visa' ? showVisa : showProp;
  }

  setTimeout(firstFn, firstDelay);
  setTimeout(secondFn, firstDelay + THREE_MIN);

