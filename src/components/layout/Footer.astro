---
import { useTranslations, getLocalizedPath, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

const zonaPath        = lang === 'es' ? '/zonas'           : lang === 'fr' ? '/zones'            : '/areas';
const costPath        = lang === 'es' ? '/costo-de-vida'   : lang === 'fr' ? '/cout-de-la-vie'   : '/cost-of-living';
const aboutPath       = lang === 'es' ? '/sobre-nosotros'  : lang === 'fr' ? '/a-propos'         : '/about';
const privPath        = lang === 'es' ? '/privacidad'      : lang === 'fr' ? '/confidentialite'  : '/privacy';
const termsPath       = lang === 'es' ? '/terminos'        : lang === 'fr' ? '/conditions'       : '/terms';
const realEstatePath  = lang === 'es' ? '/bienes-raices'   : lang === 'fr' ? '/immobilier'       : '/real-estate';
const visaCompPath    = lang === 'es' ? '/visas/comparativa': lang === 'fr' ? '/visas/comparaison': '/visas/comparison';
---

<!-- Top accent separator -->
<div class="h-[2px] bg-jade/30"></div>

<footer class="bg-slate text-white/70 mt-24">
  <div class="max-w-6xl mx-auto px-4 py-12 grid grid-cols-1 md:grid-cols-4 gap-0 md:gap-8">

    <!-- Brand -->
    <div class="pb-8 mb-8 border-b border-white/10 md:border-0 md:pb-0 md:mb-0">
      <span class="eyebrow" style="color: rgba(196, 169, 109, 0.6)">Relocation Guide</span>
      <p class="font-serif text-lg font-semibold text-white mb-2">Beyond Panama Relocation</p>
      <p class="text-sm text-white/40 leading-relaxed max-w-[200px]">{t('footer.tagline')}</p>
    </div>

    <!-- Nav links -->
    <div class="pb-8 mb-8 border-b border-white/10 md:border-0 md:pb-0 md:mb-0">
      <p class="text-xs font-semibold uppercase tracking-widest text-white/40 mb-3">
        {lang === 'es' ? 'Explorar' : lang === 'fr' ? 'Explorer' : 'Explore'}
      </p>
      <ul class="space-y-2 text-sm">
        <li><a href={getLocalizedPath(zonaPath, lang)} class="hover:text-white transition-colors">{t('nav.zonas')}</a></li>
        <li><a href={getLocalizedPath('/visas', lang)} class="hover:text-white transition-colors">{t('nav.visas')}</a></li>
        <li><a href={getLocalizedPath(costPath, lang)} class="hover:text-white transition-colors">{t('nav.costo')}</a></li>
        <li><a href={getLocalizedPath(realEstatePath, lang)} class="hover:text-white transition-colors">{lang === 'es' ? 'Bienes raíces' : lang === 'fr' ? 'Immobilier' : 'Real Estate'}</a></li>
        <li><a href={getLocalizedPath('/blog', lang)} class="hover:text-white transition-colors">{t('nav.blog')}</a></li>
        <li><a href={getLocalizedPath(aboutPath, lang)} class="hover:text-white transition-colors">{t('nav.sobre')}</a></li>
      </ul>
    </div>

    <!-- Guide links: Vivir en Panamá -->
    <div class="pb-8 mb-8 border-b border-white/10 md:border-0 md:pb-0 md:mb-0">
      <p class="text-xs font-semibold uppercase tracking-widest text-white/40 mb-3">
        {lang === 'es' ? 'Vivir en Panamá' : lang === 'fr' ? 'Vivre au Panama' : 'Life in Panama'}
      </p>
      <ul class="space-y-2 text-sm">
        {lang === 'en' && <>
          <li><a href="/en/geography-climate/" class="hover:text-white transition-colors">Geography & Climate</a></li>
          <li><a href="/en/healthcare/" class="hover:text-white transition-colors">Healthcare & Insurance</a></li>
          <li><a href="/en/communications/" class="hover:text-white transition-colors">Communications & Utilities</a></li>
          <li><a href="/en/transport/" class="hover:text-white transition-colors">Transport</a></li>
          <li><a href="/en/banking/" class="hover:text-white transition-colors">Banking & Finance</a></li>
          <li><a href="/en/education-activities/" class="hover:text-white transition-colors">Education & Activities</a></li>
          <li><a href="/en/working-in-panama/" class="hover:text-white transition-colors">Working in Panama</a></li>
          <li><a href="/en/pensionado-benefits/" class="hover:text-white transition-colors">Pensionado Benefits</a></li>
        </>}
        {lang === 'es' && <>
          <li><a href="/es/geografia-clima/" class="hover:text-white transition-colors">Geografía y Clima</a></li>
          <li><a href="/es/salud-seguros/" class="hover:text-white transition-colors">Salud y Seguros</a></li>
          <li><a href="/es/comunicaciones/" class="hover:text-white transition-colors">Comunicaciones</a></li>
          <li><a href="/es/transporte/" class="hover:text-white transition-colors">Transporte</a></li>
          <li><a href="/es/banca-finanzas/" class="hover:text-white transition-colors">Banca y Finanzas</a></li>
          <li><a href="/es/educacion-actividades/" class="hover:text-white transition-colors">Educación y Actividades</a></li>
          <li><a href="/es/trabajar-en-panama/" class="hover:text-white transition-colors">Trabajar en Panamá</a></li>
          <li><a href="/es/beneficios-pensionado/" class="hover:text-white transition-colors">Beneficios Pensionado</a></li>
        </>}
        {lang === 'fr' && <>
          <li><a href="/fr/geographie-climat/" class="hover:text-white transition-colors">Géographie et Climat</a></li>
          <li><a href="/fr/sante-assurances/" class="hover:text-white transition-colors">Santé et Assurances</a></li>
          <li><a href="/fr/communications/" class="hover:text-white transition-colors">Communications</a></li>
          <li><a href="/fr/transport/" class="hover:text-white transition-colors">Transport</a></li>
          <li><a href="/fr/banque-finances/" class="hover:text-white transition-colors">Banque et Finances</a></li>
          <li><a href="/fr/education-activites/" class="hover:text-white transition-colors">Éducation et Activités</a></li>
          <li><a href="/fr/travailler-panama/" class="hover:text-white transition-colors">Travailler au Panama</a></li>
          <li><a href="/fr/avantages-pensionado/" class="hover:text-white transition-colors">Avantages Pensionado</a></li>
        </>}
      </ul>
    </div>

    <!-- Guide links: Tu mudanza + CTA -->
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-white/40 mb-3">
        {lang === 'es' ? 'Tu Mudanza' : lang === 'fr' ? 'Votre déménagement' : 'Your Move'}
      </p>
      <ul class="space-y-2 text-sm mb-6">
        {lang === 'en' && <>
          <li><a href="/en/whats-new-2025/" class="hover:text-white transition-colors">What's New 2025</a></li>
          <li><a href="/en/testimonials/" class="hover:text-white transition-colors">Expat Testimonials</a></li>
          <li><a href="/en/next-steps/" class="hover:text-white transition-colors">Next Steps & Checklist</a></li>
          <li><a href={getLocalizedPath(visaCompPath, lang)} class="hover:text-white transition-colors">Visa Comparison</a></li>
          <li><a href="/en/visas/qualified-investor/" class="hover:text-white transition-colors">Qualified Investor Visa</a></li>
          <li><a href="/en/company-formation/" class="hover:text-white transition-colors">Company Formation</a></li>
        </>}
        {lang === 'es' && <>
          <li><a href="/es/novedades-2025/" class="hover:text-white transition-colors">Novedades 2025</a></li>
          <li><a href="/es/testimonios/" class="hover:text-white transition-colors">Testimonios</a></li>
          <li><a href="/es/proximos-pasos/" class="hover:text-white transition-colors">Próximos Pasos</a></li>
          <li><a href="/es/visas/comparativa/" class="hover:text-white transition-colors">Comparar Visas</a></li>
          <li><a href="/es/visas/inversionista-calificado/" class="hover:text-white transition-colors">Visa Inversionista Calificado</a></li>
          <li><a href="/es/constitucion-empresas/" class="hover:text-white transition-colors">Constitución de Empresas</a></li>
        </>}
        {lang === 'fr' && <>
          <li><a href="/fr/nouveautes-2025/" class="hover:text-white transition-colors">Nouveautés 2025</a></li>
          <li><a href="/fr/temoignages/" class="hover:text-white transition-colors">Témoignages</a></li>
          <li><a href="/fr/prochaines-etapes/" class="hover:text-white transition-colors">Prochaines étapes</a></li>
          <li><a href="/fr/visas/comparaison/" class="hover:text-white transition-colors">Comparer les visas</a></li>
          <li><a href="/fr/visas/investisseur-qualifie/" class="hover:text-white transition-colors">Visa Investisseur Qualifié</a></li>
          <li><a href="/fr/creation-societe/" class="hover:text-white transition-colors">Création de société</a></li>
        </>}
      </ul>
      <p class="text-xs font-semibold uppercase tracking-widest text-white/40 mb-3">
        {lang === 'es' ? '¿Por dónde empiezo?' : lang === 'fr' ? 'Par où commencer ?' : 'Where do I start?'}
      </p>
      <a
        href={getLocalizedPath('/quiz', lang)}
        class="inline-flex items-center px-5 py-2.5 rounded-sm bg-gold text-slate text-sm font-medium hover:bg-gold-light transition-colors"
      >
        {t('cta.empezar')} →
      </a>
    </div>

  </div>

  <!-- Bottom bar -->
  <div class="border-t border-white/10">
    <div class="max-w-6xl mx-auto px-4 py-4 flex flex-col sm:flex-row justify-between items-center gap-2 text-xs text-white/40">
      <span>© {year} Beyond Panama Relocation <span class="text-white/20">· Built for expats</span></span>
      <div class="flex items-center gap-4">
        <!-- Instagram -->
        <a href="https://www.instagram.com/beyondpanamarelocation" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="hover:text-white/70 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
        </a>
        <!-- WhatsApp -->
        <a href="https://wa.me/50760844256" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="hover:text-white/70 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        </a>
        <a href={getLocalizedPath(privPath, lang)} class="hover:text-white/70 transition-colors">{t('footer.privacidad')}</a>
        <a href={getLocalizedPath(termsPath, lang)} class="hover:text-white/70 transition-colors">{t('footer.terminos')}</a>
      </div>
    </div>
  </div>
</footer>
