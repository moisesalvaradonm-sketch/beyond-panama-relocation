---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import WhatsAppFloat from '../components/ui/WhatsAppFloat.astro';
import PromoPopups from '../components/ui/PromoPopups.astro';
import { getLangFromUrl, translatePath } from '../i18n/ui';

interface Props {
  title: string;
  description?: string;
  lang?: 'es' | 'en' | 'fr';
  ogImage?: string;
  canonicalUrl?: string;
  noindex?: boolean;
  pubDate?: Date;
  articleAuthor?: string;
  articleSection?: string;
  /** Landing-page mode: no site nav/footer/popups, no cross-language hreflang. */
  minimal?: boolean;
}

const {
  title,
  description = '',
  lang,
  ogImage,
  canonicalUrl,
  noindex = false,
  pubDate,
  articleAuthor,
  articleSection,
  minimal = false,
} = Astro.props;

const currentLang = lang ?? getLangFromUrl(Astro.url);
const siteUrl = 'https://beyondpanamarelocation.com';
const canonical = canonicalUrl ?? Astro.url.href;
const ogLocale = currentLang === 'es' ? 'es_PA' : currentLang === 'fr' ? 'fr_FR' : 'en_US';
const schemaLang = currentLang === 'es' ? 'es-PA' : currentLang === 'fr' ? 'fr-FR' : 'en-US';
const ogImageAbsolute = ogImage
  ? (ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`)
  : `${siteUrl}/img/og-default.png`;
const fullTitle = `${title} — Beyond Panama Relocation`;
const ogType = pubDate ? 'article' : 'website';

const pathname = Astro.url.pathname;
const selfUrl = `${siteUrl}${pathname}`;

// Strip lang prefix to get the locale-independent path (e.g. /blog/slug/)
const pathWithoutLang = pathname.replace(new RegExp(`^/${currentLang}`), '') || '/';

// Build hreflang URLs using translatePath so blog slugs get correctly mapped
// cross-language (falls back to /blog/ index when no translation exists)
const hrefLangs = (['es', 'en', 'fr'] as const).map(l => ({
  lang: l,
  url: l === currentLang
    ? `${siteUrl}${pathname}`
    : `${siteUrl}/${l}${translatePath(pathWithoutLang, currentLang, l)}`,
}));

// ── Schema: WebSite ──────────────────────────────────────────────────────────
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Beyond Panama Relocation',
  url: siteUrl,
  description: description || 'Your trilingual guide to relocating and living in Panama.',
  inLanguage: schemaLang,
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${siteUrl}/en/?s={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
};

// ── Schema: Organization ─────────────────────────────────────────────────────
// Beyond Panama Relocation is a relocation information service — not a law
// firm, not a visa provider. Do not characterise it as either.
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Beyond Panama Relocation',
  url: siteUrl,
  logo: {
    '@type': 'ImageObject',
    url: `${siteUrl}/img/logo-horizontal.webp`,
    width: 600,
    height: 200,
  },
  description:
    'A trilingual relocation information service helping people make well-informed decisions about moving to Panama.',
  areaServed: {
    '@type': 'Country',
    name: 'Panama',
  },
  knowsLanguage: ['en', 'es', 'fr'],
  foundingDate: '2024',
  founder: {
    '@type': 'Person',
    '@id': `${siteUrl}/en/about/#author`,
    name: 'Moisés Alvarado',
    url: `${siteUrl}/en/about/`,
  },
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer support',
    url: `${siteUrl}/en/contact/`,
    availableLanguage: ['English', 'Spanish', 'French'],
  },
  sameAs: [
    'https://www.facebook.com/beyondpanamarelocation',
    'https://www.instagram.com/beyondpanamarelocation',
  ],
};

// ── Schema: BreadcrumbList ────────────────────────────────────────────────────
// Only emit for inner pages (skip home / lang root).
// Segments after the lang prefix are converted from kebab-case to Title Case
// for intermediate items; the current page uses the page `title` prop.

interface BreadcrumbListItem {
  '@type': 'ListItem';
  position: number;
  name: string;
  item: string;
}

const pathSegments = pathname.split('/').filter(Boolean); // e.g. ['en','visas','pensionado']
const contentSegments = pathSegments.slice(1);            // drop lang prefix

function kebabToTitle(s: string): string {
  return s
    .split('-')
    .map(w => w.charAt(0).toUpperCase() + w.slice(1))
    .join(' ');
}

let breadcrumbSchema: object | null = null;

if (contentSegments.length > 0) {
  const langPrefix = pathSegments[0]; // 'en' | 'es'
  const homeLabel = currentLang === 'es' ? 'Inicio' : currentLang === 'fr' ? 'Accueil' : 'Home';

  const items: BreadcrumbListItem[] = [
    {
      '@type': 'ListItem',
      position: 1,
      name: homeLabel,
      item: `${siteUrl}/${langPrefix}`,
    },
  ];

  contentSegments.forEach((segment, index) => {
    const isLast = index === contentSegments.length - 1;
    const cumulativePath = `/${langPrefix}/${contentSegments.slice(0, index + 1).join('/')}`;
    items.push({
      '@type': 'ListItem',
      position: index + 2,
      name: isLast ? title : kebabToTitle(segment),
      item: `${siteUrl}${cumulativePath}`,
    });
  });

  breadcrumbSchema = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: items,
  };
}
---

<!doctype html>
<html lang={currentLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-512.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/favicon-512.png" />

    <!-- Canonical -->
    <link rel="canonical" href={canonical} />

    <!-- Hreflang -->
    {!minimal && hrefLangs.map(({ lang: l, url }) => (
      <link rel="alternate" hreflang={l} href={url} />
    ))}
    {!minimal && <link rel="alternate" hreflang="x-default" href={`${siteUrl}/en`} />}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Beyond Panama Relocation" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />

    <!-- Article meta (blog posts only) -->
    {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
    {pubDate && <meta property="article:modified_time" content={pubDate.toISOString()} />}
    {articleAuthor && <meta property="article:author" content={articleAuthor} />}
    {articleSection && <meta property="article:section" content={articleSection} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsolute} />

    <!-- Fonts: dns-prefetch + preconnect + stylesheet -->
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,300;1,9..40,400&display=swap"
      rel="stylesheet"
    />

    <title>{fullTitle}</title>

    <!-- JSON-LD: WebSite -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

    <!-- JSON-LD: Organization -->
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

    <!-- JSON-LD: BreadcrumbList (inner pages only) -->
    {breadcrumbSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    )}

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-682B073RCZ"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-682B073RCZ');
    </script>
  </head>
  <body>
    {!minimal && <Header lang={currentLang} />}
    <main>
      <slot />
    </main>
    {!minimal && <Footer lang={currentLang} />}
    {!minimal && <WhatsAppFloat lang={currentLang} />}
    {!minimal && <PromoPopups />}

    {/* Beyond Panama Lead Engine — behavior tracker (page views, WhatsApp clicks,
        consultation clicks, guide downloads). Adds no visible UI. */}
    <script src="/js/bpr-tracker.js" defer></script>

    <script>
      // Scroll-triggered animation observer
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
      );
      document.querySelectorAll('[data-animate]').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
