---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import WhatsAppFloat from '../components/ui/WhatsAppFloat.astro';
import PromoPopups from '../components/ui/PromoPopups.astro';
import CookieConsent from '../components/ui/CookieConsent.astro';
import { getLangFromUrl, translatePathStrict, type Lang } from '../i18n/ui';
import { getRouteSet, isNoindexPath } from '../seo';

interface Props {
  title: string;
  description?: string;
  lang?: 'es' | 'en' | 'fr';
  ogImage?: string;
  canonicalUrl?: string;
  noindex?: boolean;
  pubDate?: Date;
  /** Real last-update date (dateModified / article:modified_time). Falls back to pubDate. */
  modDate?: Date;
  articleAuthor?: string;
  articleSection?: string;
  /** Landing-page mode: no site nav/footer/popups, no cross-language hreflang. */
  minimal?: boolean;
}

const {
  title,
  description = '',
  lang,
  ogImage,
  canonicalUrl,
  noindex: noindexProp = false,
  pubDate,
  modDate,
  articleAuthor,
  articleSection,
  minimal = false,
} = Astro.props;

const currentLang = lang ?? getLangFromUrl(Astro.url);
const noindex = noindexProp || isNoindexPath(Astro.url.pathname);
const siteUrl = 'https://beyondpanamarelocation.com';
const canonical = canonicalUrl ?? Astro.url.href;
const ogLocale = currentLang === 'es' ? 'es_PA' : currentLang === 'fr' ? 'fr_FR' : 'en_US';
const schemaLang = currentLang === 'es' ? 'es-PA' : currentLang === 'fr' ? 'fr-FR' : 'en-US';
const ogImageAbsolute = ogImage
  ? (ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`)
  : `${siteUrl}/img/og-default.png`;
const fullTitle = `${title} — Beyond Panama Relocation`;
const ogType = pubDate ? 'article' : 'website';

const pathname = Astro.url.pathname;
const selfUrl = `${siteUrl}${pathname}`;

// Strip lang prefix to get the locale-independent path (e.g. /blog/slug/)
const pathWithoutLang = pathname.replace(new RegExp(`^/${currentLang}`), '') || '/';

// hreflang: only real, indexable translations (never an index page as a stand-in).
// Reciprocal by construction: every page in a cluster computes the same set.
const routes = await getRouteSet();
const hrefLangs: { lang: Lang; url: string }[] = [];
if (!noindex) {
  for (const l of ['es', 'en', 'fr'] as const) {
    const p = l === currentLang ? pathWithoutLang : translatePathStrict(pathWithoutLang, currentLang, l);
    if (!p) continue;
    const full = `/${l}${p}`;
    if (l !== currentLang && (!routes.has(full) || isNoindexPath(full))) continue;
    hrefLangs.push({ lang: l, url: `${siteUrl}${full}` });
  }
}
const xDefault = hrefLangs.find(h => h.lang === 'en')?.url;

// ── Schema: WebSite ──────────────────────────────────────────────────────────
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Beyond Panama Relocation',
  url: siteUrl,
  description: description || 'Your trilingual guide to relocating and living in Panama.',
  inLanguage: schemaLang,
};

// ── Schema: Organization ─────────────────────────────────────────────────────
// Beyond Panama Relocation is a relocation information service — not a law
// firm, not a visa provider. Do not characterise it as either.
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Beyond Panama Relocation',
  url: siteUrl,
  logo: {
    '@type': 'ImageObject',
    url: `${siteUrl}/img/logo-horizontal.webp`,
    width: 600,
    height: 200,
  },
  description:
    'A trilingual relocation information service helping people make well-informed decisions about moving to Panama.',
  areaServed: {
    '@type': 'Country',
    name: 'Panama',
  },
  knowsLanguage: ['en', 'es', 'fr'],
  foundingDate: '2024',
  founder: {
    '@type': 'Person',
    '@id': `${siteUrl}/en/about/#author`,
    name: 'Moisés Alvarado',
    url: `${siteUrl}/en/about/`,
  },
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer support',
    url: `${siteUrl}/en/contact/`,
    availableLanguage: ['English', 'Spanish', 'French'],
  },
  sameAs: [
    'https://www.facebook.com/beyondpanamarelocation',
    'https://www.instagram.com/beyondpanamarelocation',
  ],
};

// ── Schema: BreadcrumbList ────────────────────────────────────────────────────
// Only emit for inner pages (skip home / lang root).
// Segments after the lang prefix are converted from kebab-case to Title Case
// for intermediate items; the current page uses the page `title` prop.

const pathSegments = pathname.split('/').filter(Boolean); // e.g. ['en','visas','pensionado']
const contentSegments = pathSegments.slice(1);            // drop lang prefix

// Section labels for intermediate crumbs (fallback: Title Case of the slug).
const sectionLabels: Record<string, Record<Lang, string>> = {
  visas:    { en: 'Visas & Residency', es: 'Visas y Residencia', fr: 'Visas & Résidence' },
  areas:    { en: 'Areas to Live', es: 'Zonas para Vivir', fr: 'Régions pour Vivre' },
  zonas:    { en: 'Areas to Live', es: 'Zonas para Vivir', fr: 'Régions pour Vivre' },
  zones:    { en: 'Areas to Live', es: 'Zonas para Vivir', fr: 'Régions pour Vivre' },
  blog:     { en: 'Blog', es: 'Blog', fr: 'Blog' },
  insights: { en: 'Beyond Insights', es: 'Beyond Insights', fr: 'Beyond Insights' },
};

function kebabToTitle(s: string): string {
  return s
    .split('-')
    .map(w => w.charAt(0).toUpperCase() + w.slice(1))
    .join(' ');
}

let breadcrumbSchema: object | null = null;

if (contentSegments.length > 0) {
  const langPrefix = pathSegments[0]; // 'en' | 'es' | 'fr'
  const homeLabel = currentLang === 'es' ? 'Inicio' : currentLang === 'fr' ? 'Accueil' : 'Home';

  const crumbs: { name: string; item: string }[] = [
    { name: homeLabel, item: `${siteUrl}/${langPrefix}/` },
  ];

  contentSegments.forEach((segment, index) => {
    const isLast = index === contentSegments.length - 1;
    const cumulativePath = `/${langPrefix}/${contentSegments.slice(0, index + 1).join('/')}/`;
    // Skip intermediate crumbs that are not real pages
    if (!isLast && !routes.has(cumulativePath)) return;
    crumbs.push({
      name: isLast ? title : (sectionLabels[segment]?.[currentLang] ?? kebabToTitle(segment)),
      item: `${siteUrl}${cumulativePath}`,
    });
  });

  breadcrumbSchema = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, ...c })),
  };
}

const isHome = contentSegments.length === 0;
---

<!doctype html>
<html lang={currentLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-512.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/favicon-512.png" />

    <!-- Canonical -->
    <link rel="canonical" href={canonical} />

    <!-- Hreflang -->
    {!minimal && hrefLangs.length > 1 && hrefLangs.map(({ lang: l, url }) => (
      <link rel="alternate" hreflang={l} href={url} />
    ))}
    {!minimal && xDefault && hrefLangs.length > 1 && <link rel="alternate" hreflang="x-default" href={xDefault} />}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Beyond Panama Relocation" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />

    <!-- Article meta (blog posts only) -->
    {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
    {pubDate && <meta property="article:modified_time" content={(modDate ?? pubDate).toISOString()} />}
    {articleAuthor && <meta property="article:author" content={articleAuthor} />}
    {articleSection && <meta property="article:section" content={articleSection} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsolute} />

    <!-- Fonts: dns-prefetch + preconnect + stylesheet -->
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,300;1,9..40,400&display=swap"
      rel="stylesheet"
    />

    <title>{fullTitle}</title>

    <!-- JSON-LD: WebSite + Organization (home pages only) -->
    {isHome && <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />}
    {isHome && <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />}

    <!-- JSON-LD: BreadcrumbList (inner pages only) -->
    {breadcrumbSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    )}

  </head>
  <body>
    {!minimal && <Header lang={currentLang} />}
    <main>
      <slot />
    </main>
    {!minimal && <Footer lang={currentLang} />}
    {!minimal && <WhatsAppFloat lang={currentLang} />}
    {!minimal && <PromoPopups />}
    {/* Consent-gated GA4 + Microsoft Clarity: load only after the visitor accepts */}
    <CookieConsent lang={currentLang} />

    {/* Beyond Panama Lead Engine — behavior tracker (page views, WhatsApp clicks,
        consultation clicks, guide downloads). Adds no visible UI. */}
    <script src="/js/bpr-tracker.js" defer></script>

    <script>
      // Scroll-triggered animation observer
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
      );
      document.querySelectorAll('[data-animate]').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
