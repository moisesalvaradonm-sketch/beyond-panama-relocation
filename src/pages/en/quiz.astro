---
import Layout from '../../layouts/Layout.astro';
import Quiz from '../../components/quiz/Quiz';

const quizSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Panama Visa Quiz',
  url: 'https://beyondpanamarelocation.com/en/quiz/',
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'Web',
  description: 'Find your route to Panama in 2 minutes based on your real profile and budget.',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  inLanguage: 'en-US',
};
---

<Layout
  title="Your Route to Panama"
  description="Find your route in 2 minutes based on what you're really looking for in Panama."
  lang="en"
>
  <script type="application/ld+json" set:html={JSON.stringify(quizSchema)} />
  <!-- Hidden form for Netlify to detect at build time -->
  <form name="quiz-subscribe-en" data-netlify="true" netlify-honeypot="bot-field" hidden>
    <input type="text" name="name" />
    <input type="email" name="email" />
    <input type="tel" name="phone" />
    <input type="hidden" name="clima" />
    <input type="hidden" name="comunidad" />
    <input type="hidden" name="actividades" />
    <input type="hidden" name="presupuesto_prop" />
    <input type="hidden" name="tipo_prop" />
    <input type="hidden" name="espanol" />
    <input type="hidden" name="plazo" />
    <input type="hidden" name="origen" />
    <input type="hidden" name="etapa" />
    <input type="hidden" name="proposito" />
    <input type="hidden" name="trabajo" />
    <input type="hidden" name="acompanantes" />
    <input type="hidden" name="visita" />
    <input type="hidden" name="notas" />
    <input type="hidden" name="contacto" />
    <input name="bot-field" />
  </form>

  <section class="max-w-2xl mx-auto px-4 py-16">
    <div class="text-center mb-10">
      <span class="text-jade text-sm font-medium uppercase tracking-widest">Your personalized route</span>
      <h1 class="font-serif text-3xl md:text-4xl text-slate mt-2 mb-3">
        What are you looking for in Panama?
      </h1>
      <p class="text-slate-mid">
        2 minutes · no registration · no commitment
      </p>
    </div>
    <Quiz lang="en" client:load />
  </section>
</Layout>
