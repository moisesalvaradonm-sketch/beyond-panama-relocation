---
import Layout from '../../../layouts/Layout.astro';

const areas = [
  {
    title: 'Panama City',
    tag: 'Urban · Cosmopolitan · Financial hub',
    climate: '27–32 °C',
    rent: '$800 – $3,000+ / mo',
    profile: 'Professionals · Investors · Nomads',
    desc: "The only place in Panama where you can have everything — jobs, international flights, world-class hospitals, and an urban lifestyle. Also the most expensive.",
    href: '/en/areas/panama-city',
    photo: 'https://images.unsplash.com/photo-1598041543955-0d88c390f3b5?w=800&auto=format&fit=crop&q=80',
    color: 'bg-jade/8',
  },
  {
    title: 'Boquete & Chiriquí',
    tag: 'Highland · Cool climate · Established expat community',
    climate: '15–24 °C',
    rent: '$500 – $1,500 / mo',
    profile: 'Retirees · Nature lovers · Remote workers',
    desc: "Perpetual spring, stunning highland nature, and one of Panama's lowest costs of living. The top choice for North American retirees for good reason.",
    href: '/en/areas/boquete',
    photo: 'https://images.unsplash.com/photo-1542273917363-3b1817f69a2d?w=800&auto=format&fit=crop&q=80',
    color: 'bg-gold/8',
  },
  {
    title: 'Coronado & Pacific Coast',
    tag: 'Beach · 80 km from capital · Retiree favorite',
    climate: '28–35 °C',
    rent: '$600 – $2,000 / mo',
    profile: 'Beach seekers · Second-home buyers',
    desc: "Pacific dark-sand beach with all the essentials — and none of the excess. Supermarkets, golf, ocean-front condos an hour from the city.",
    href: '/en/areas/coronado',
    photo: 'https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=800&auto=format&fit=crop&q=80',
    color: 'bg-coral/8',
  },
  {
    title: 'Bocas del Toro',
    tag: 'Caribbean · Islands · Bohemian',
    climate: '26–30 °C',
    rent: '$400 – $1,200 / mo',
    profile: 'Adventurers · Artists · Off-grid seekers',
    desc: "A Caribbean archipelago like no other. The lowest cost of living of all areas. Bohemian, alternative community. Not for everyone — for those who fit, it's hard to leave.",
    href: '/en/areas/bocas-del-toro',
    photo: 'https://images.unsplash.com/photo-1559827260-dc66d52bef19?w=800&auto=format&fit=crop&q=80',
    color: 'bg-jade/8',
  },
  {
    title: 'Pedasí & Azuero Peninsula',
    tag: 'Authentic · Surf · Whale watching',
    climate: '26–35 °C',
    rent: '$400 – $1,000 / mo',
    profile: 'Surfers · Nature seekers · Authentic life',
    desc: "A fishing village with uncrowded Pacific beaches, whale watching from July to October, and a pace of life that resembles Panama of 30 years ago.",
    href: '/en/areas/pedasi',
    photo: 'https://images.unsplash.com/photo-1583440025212-16269892d7ac?w=800&auto=format&fit=crop&q=80',
    color: 'bg-gold/8',
  },
  {
    title: 'San Carlos & Santa Clara',
    tag: 'Pacific · Closest beach to capital · Affordable',
    climate: '27–33 °C',
    rent: '$450 – $1,400 / mo',
    profile: 'Families · Weekend residents',
    desc: "The Pacific beaches closest to Panama City. Under an hour from the capital, with more affordable prices than Coronado and a growing expat community.",
    href: '/en/areas/san-carlos',
    photo: 'https://images.unsplash.com/photo-1510414842594-a61c69b5ae57?w=800&auto=format&fit=crop&q=80',
    color: 'bg-coral/8',
  },
];
---

<Layout
  title="Areas to Live in Panama"
  description="Compare the main areas to live in Panama: Panama City, Boquete, Coronado, Bocas del Toro, Pedasí and San Carlos. Real prices, expat community and lifestyle."
  lang="en"
>

  <!-- Page header — warm & human -->
  <section class="bg-fog border-b border-jade/10">
    <div class="max-w-5xl mx-auto px-6 md:px-8 py-16 md:py-20">
      <a href="/en/" class="text-jade-dark text-xs tracking-[0.12em] uppercase hover:underline">← Home</a>
      <div class="mt-6 max-w-2xl" data-animate>
        <span class="eyebrow">Where will you live?</span>
        <h1 class="font-serif text-4xl md:text-5xl text-slate leading-tight mb-5">
          Areas to Live in Panama
        </h1>
        <p class="text-slate-mid text-lg leading-relaxed">
          Panama is a small country with a remarkable variety of climates, lifestyles, and price
          points. Not every area is right for everyone — compare the six main ones and find yours.
        </p>
      </div>
    </div>
  </section>

  <!-- Area cards — Bloom-style with photo -->
  <section class="max-w-5xl mx-auto px-6 md:px-8 py-16">
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {areas.map((area, i) => (
        <a
          href={area.href}
          class="group flex flex-col bg-white border border-jade/10 hover:border-jade/25 hover:shadow-lg transition-all duration-300 overflow-hidden"
          data-animate
          data-delay={String((i % 3) + 1)}
        >
          <!-- Photo -->
          <div class="relative aspect-[4/3] overflow-hidden bg-slate/20">
            <img
              src={area.photo}
              alt={area.title}
              class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
              decoding="async"
            />
            <!-- Gradient -->
            <div class="absolute inset-0 bg-gradient-to-t from-slate/70 via-transparent to-transparent pointer-events-none" aria-hidden="true"></div>
            <!-- Location name on photo -->
            <div class="absolute bottom-0 left-0 right-0 p-4">
              <p class="text-[0.6rem] text-white/60 uppercase tracking-[0.18em] mb-1">{area.tag}</p>
              <h2 class="font-serif text-white text-xl font-semibold leading-tight">
                {area.title}
              </h2>
            </div>
          </div>

          <!-- Card body -->
          <div class="flex flex-col flex-1 p-5">
            <!-- Stats row (like Bloom's sessions/reviews/years) -->
            <div class="flex gap-4 mb-4 pb-4 border-b border-jade/8">
              <div>
                <p class="text-[0.6rem] text-slate-mid uppercase tracking-widest mb-0.5">Climate</p>
                <p class="font-serif text-sm text-slate font-semibold">{area.climate}</p>
              </div>
              <div class="border-l border-jade/10 pl-4">
                <p class="text-[0.6rem] text-slate-mid uppercase tracking-widest mb-0.5">Rent</p>
                <p class="font-serif text-sm text-slate font-semibold">{area.rent}</p>
              </div>
            </div>

            <!-- Profile -->
            <p class="text-[0.65rem] text-jade uppercase tracking-[0.15em] font-medium mb-2">{area.profile}</p>

            <!-- Description -->
            <p class="text-sm text-slate-mid leading-relaxed mb-5 flex-1">{area.desc}</p>

            <!-- CTA -->
            <span class="inline-flex items-center gap-1.5 text-sm font-medium text-jade group-hover:gap-2.5 transition-all duration-200">
              Full guide
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Quick-reference comparison table -->
  <section class="max-w-5xl mx-auto px-6 md:px-8 pb-12" data-animate>
    <h2 class="font-serif text-2xl text-slate mb-6">Side-by-side comparison</h2>
    <div class="overflow-x-auto border border-jade/10 bg-white">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-jade/10 text-left bg-fog">
            <th class="px-5 py-4 font-semibold text-slate text-xs tracking-wide">Area</th>
            <th class="px-5 py-4 font-semibold text-slate text-xs tracking-wide">Climate</th>
            <th class="px-5 py-4 font-semibold text-slate text-xs tracking-wide">Typical rent</th>
            <th class="px-5 py-4 font-semibold text-slate text-xs tracking-wide">Main profile</th>
            <th class="px-5 py-4 font-semibold text-slate text-xs tracking-wide">Internet</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-jade/5">
          {[
            ['Panama City', 'Tropical, 27–32 °C', '$800 – $3,000+', 'Professionals, investors', 'Excellent', 'text-jade'],
            ['Boquete / Chiriquí', 'Cool, 15–24 °C', '$500 – $1,500', 'Retirees, nature lovers', 'Good', 'text-jade'],
            ['Coronado / Pacific', 'Dry, 28–35 °C', '$600 – $2,000', 'Beach, second home', 'Acceptable', 'text-slate-mid'],
            ['Bocas del Toro', 'Caribbean, 26–30 °C', '$400 – $1,200', 'Adventurers, artists', 'Limited', 'text-coral'],
            ['Pedasí / Azuero', 'Tropical dry, 26–35 °C', '$400 – $1,000', 'Surf, authentic life', 'Basic', 'text-coral'],
            ['San Carlos / Santa Clara', 'Pacific, 27–33 °C', '$450 – $1,400', 'Beach close to capital', 'Acceptable', 'text-slate-mid'],
          ].map(([area, climate, rent, profile, internet, iClass]) => (
            <tr class="hover:bg-fog/60 transition-colors">
              <td class="px-5 py-3.5 font-medium text-slate text-xs">{area}</td>
              <td class="px-5 py-3.5 text-slate-mid text-xs">{climate}</td>
              <td class="px-5 py-3.5 text-slate-mid text-xs">{rent}</td>
              <td class="px-5 py-3.5 text-slate-mid text-xs">{profile}</td>
              <td class={`px-5 py-3.5 text-xs font-medium ${iClass}`}>{internet}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="px-5 py-3 text-xs text-slate-mid border-t border-jade/5">
        Rent ranges for a 1–2 bedroom. Market references 2025–2026. Source: Beyond Panama internal research.
      </p>
    </div>
  </section>

  <!-- CTA — warm, human, no pressure -->
  <section class="bg-fog border-t border-jade/10" data-animate>
    <div class="max-w-5xl mx-auto px-6 md:px-8 py-16 flex flex-col md:flex-row md:items-center gap-8">
      <div class="flex-1">
        <span class="eyebrow">Not sure where to start?</span>
        <h2 class="font-serif text-2xl md:text-3xl text-slate mb-3">
          We'll help you find your area.
        </h2>
        <p class="text-slate-mid leading-relaxed text-sm max-w-md">
          The quiz asks a few questions about your lifestyle, budget, and priorities — and
          recommends the area that fits best. Takes 2 minutes, no sign-up required.
        </p>
      </div>
      <div class="flex flex-col sm:flex-row gap-3 md:flex-col md:items-end">
        <a
          href="/en/quiz"
          class="inline-flex items-center justify-center px-7 py-3.5 bg-jade text-white font-semibold text-sm rounded-sm hover:bg-jade-dark transition-colors"
        >
          Take the quiz →
        </a>
        <a
          href="/en/cost-of-living"
          class="inline-flex items-center justify-center px-7 py-3.5 border border-jade/30 text-jade font-medium text-sm rounded-sm hover:bg-jade/5 transition-colors"
        >
          Cost calculator →
        </a>
      </div>
    </div>
  </section>

</Layout>
