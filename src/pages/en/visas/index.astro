---
import Layout from '../../../layouts/Layout.astro';

const visas = [
  {
    emoji: '🌴',
    title: 'Pensionado Visa',
    tag: 'Retirees',
    requirement: '$1,000/month lifetime pension',
    idealFor: 'Retirees with a pension from any country',
    href: '/en/visas/pensionado/',
  },
  {
    emoji: '🌐',
    title: 'Friendly Nations Visa',
    tag: '~50 countries',
    requirement: 'Economic or professional ties to Panama',
    idealFor: 'Professionals & remote workers from 50 nations',
    href: '/en/visas/friendly-nations/',
  },
  {
    emoji: '💻',
    title: 'Digital Nomad Visa',
    tag: 'Remote workers',
    requirement: '$3,000+/month foreign income',
    idealFor: 'Remote workers employed by non-Panamanian companies',
    href: '/en/visas/digital-nomad/',
  },
  {
    emoji: '📈',
    title: 'Qualified Investor Visa',
    tag: 'Investors',
    requirement: 'Min. $300,000 investment in Panama',
    idealFor: 'Investors seeking immediate permanent residency',
    href: '/en/visas/qualified-investor/',
  },
  {
    emoji: '🏦',
    title: 'Rentista Retirado Visa',
    tag: 'Fixed deposit',
    requirement: 'Fixed deposit generating $850+/month in state bank',
    idealFor: 'Investors with capital who want the Special Passport',
    href: '/en/visas/rentista-retirado/',
  },
  {
    emoji: '🌳',
    title: 'Reforestation Visa',
    tag: 'Nature investors',
    requirement: 'Min. $100,000 in a certified forestry project',
    idealFor: 'Nature-focused investors with moderate capital',
    href: '/en/visas/reforestation/',
  },
];
---

<Layout
  title="Panama Visas & Residency"
  description="Compare the 6 main residency routes in Panama: Pensionado, Friendly Nations, Qualified Investor, Rentista Retirado, Reforestation and Digital Nomad."
  lang="en"
>
  <!-- Hero banner -->
  <div class="relative overflow-hidden bg-slate">
    <img
      src="/img/areas/panama-city-aerial.webp"
      alt="Aerial view of Panama City"
      class="absolute inset-0 w-full h-full object-cover object-center opacity-30"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-slate/95 via-slate/75 to-slate/40"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-slate/80 to-transparent"></div>
    <div class="relative z-10 max-w-4xl mx-auto px-4 py-16 md:py-24">
      <a href="/en/" class="text-white/55 hover:text-white text-sm transition-colors">← Home</a>
      <h1 class="font-serif text-4xl md:text-5xl text-white mt-5 mb-5 leading-tight">Panama Visas &amp; Residency</h1>
      <p class="text-white/70 text-lg max-w-2xl leading-relaxed">
        Panama has 50+ immigration categories. The 6 that matter for most people who want
        to live here — explained clearly, without legal jargon or pressure to choose quickly.
      </p>
    </div>
  </div>

  <section class="max-w-4xl mx-auto px-4 py-12">

    <!-- Visa Cards -->
    <div class="grid md:grid-cols-2 gap-5 mb-12">
      {visas.map(visa => (
        <a
          href={visa.href}
          class="group relative p-6 rounded-2xl bg-white border border-jade/10 hover:border-jade/30 hover:shadow-md transition-all"
        >
          {visa.alert && (
            <div class="absolute top-4 right-4 text-xs font-bold text-coral bg-coral/10 px-2 py-0.5 rounded-full">
              {visa.alert}
            </div>
          )}
          <div class="text-3xl mb-3">{visa.emoji}</div>
          <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-jade/10 text-jade">
            {visa.tag}
          </span>
          <h2 class="font-serif text-xl font-semibold text-slate mt-3 mb-2 group-hover:text-jade transition-colors">
            {visa.title}
          </h2>
          <dl class="text-sm text-slate-mid space-y-1 mb-4">
            <div class="flex gap-1.5">
              <dt class="font-medium text-slate shrink-0">Key req:</dt>
              <dd>{visa.requirement}</dd>
            </div>
            <div class="flex gap-1.5">
              <dt class="font-medium text-slate shrink-0">Best for:</dt>
              <dd>{visa.idealFor}</dd>
            </div>
          </dl>
          <span class="text-jade text-sm font-medium">Full requirements →</span>
        </a>
      ))}
    </div>

    <!-- Quick-reference table -->
    <h2 class="font-serif text-2xl text-slate mb-4">Quick comparison</h2>
    <div class="overflow-x-auto mb-12 rounded-2xl border border-jade/10 bg-white">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-jade/10 text-left bg-fog">
            <th class="px-5 py-4 font-semibold text-slate">Visa</th>
            <th class="px-5 py-4 font-semibold text-slate">Best for</th>
            <th class="px-5 py-4 font-semibold text-slate">Key requirement</th>
            <th class="px-5 py-4 font-semibold text-slate">Timeline</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-jade/5">
          <tr class="hover:bg-jade/3 transition-colors">
            <td class="px-5 py-4"><a href="/en/visas/pensionado/" class="font-semibold text-jade hover:underline">Pensionado</a></td>
            <td class="px-5 py-4 text-slate-mid">Retirees with pension</td>
            <td class="px-5 py-4 text-slate-mid">$1,000/mo pension</td>
            <td class="px-5 py-4 text-slate-mid">3–6 months</td>
          </tr>
          <tr class="hover:bg-jade/3 transition-colors">
            <td class="px-5 py-4"><a href="/en/visas/friendly-nations/" class="font-semibold text-jade hover:underline">Friendly Nations</a></td>
            <td class="px-5 py-4 text-slate-mid">Nationals of ~50 countries</td>
            <td class="px-5 py-4 text-slate-mid">Lawful economic activity</td>
            <td class="px-5 py-4 text-slate-mid">3–6 months</td>
          </tr>
          <tr class="hover:bg-jade/3 transition-colors">
            <td class="px-5 py-4">
              <a href="/en/visas/digital-nomad/" class="font-semibold text-jade hover:underline">Digital Nomad</a>
            </td>
            <td class="px-5 py-4 text-slate-mid">Remote workers</td>
            <td class="px-5 py-4 text-slate-mid">$36K/year remote income</td>
            <td class="px-5 py-4 text-slate-mid">1–2 months</td>
          </tr>
          <tr class="hover:bg-jade/3 transition-colors bg-gold/3">
            <td class="px-5 py-4">
              <a href="/en/visas/qualified-investor/" class="font-semibold text-jade hover:underline">Qualified Investor</a>
            </td>
            <td class="px-5 py-4 text-slate-mid">Investors</td>
            <td class="px-5 py-4 text-slate-mid">$300K real estate</td>
            <td class="px-5 py-4 text-slate-mid">2–4 months</td>
          </tr>
          <tr class="hover:bg-jade/3 transition-colors">
            <td class="px-5 py-4"><a href="/en/visas/rentista-retirado/" class="font-semibold text-jade hover:underline">Rentista Retirado</a></td>
            <td class="px-5 py-4 text-slate-mid">Capital holders · no age limit</td>
            <td class="px-5 py-4 text-slate-mid">~$250K fixed deposit (state bank)</td>
            <td class="px-5 py-4 text-slate-mid">~6 months</td>
          </tr>
          <tr class="hover:bg-jade/3 transition-colors">
            <td class="px-5 py-4"><a href="/en/visas/reforestation/" class="font-semibold text-jade hover:underline">Reforestation</a></td>
            <td class="px-5 py-4 text-slate-mid">Forestry investors</td>
            <td class="px-5 py-4 text-slate-mid">$100K in forest project</td>
            <td class="px-5 py-4 text-slate-mid">4–8 months</td>
          </tr>
        </tbody>
      </table>
      <p class="px-5 py-3 text-xs text-slate-mid border-t border-jade/5">
        Data references 2025–2026. Requirements can change — always verify with a licensed attorney.
      </p>
    </div>

    <!-- Not sure section -->
    <div class="p-8 rounded-2xl bg-jade/5 border border-jade/15 text-center">
      <p class="font-serif text-xl text-slate mb-2">Not sure which one applies to you?</p>
      <p class="text-slate-mid text-sm mb-5 max-w-md mx-auto">
        Compare all 5 visas side by side, or take the 2-minute quiz to get a neutral recommendation based on your situation.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/en/visas/comparison/" class="px-6 py-3 rounded-full border border-jade text-jade font-medium text-sm hover:bg-jade/5 transition-colors">
          See full comparison →
        </a>
        <a href="/en/quiz/" class="px-6 py-3 rounded-full bg-jade text-white font-medium text-sm hover:bg-jade-dark transition-colors">
          Find your route →
        </a>
      </div>
    </div>

  </section>
</Layout>
