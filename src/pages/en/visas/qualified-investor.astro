---
import VisaPage from '../../../components/ui/VisaPage.astro';
---
{/*
  Updated to Executive Decree No. 17 of 2026 (in force 16 Sep 2026; replaces Decree 722 of 2020),
  following the article /en/blog/qualified-investor-decree-2026/. Source of every figure below.
  Items marked [VERIFICAR] were carried over from the previous version of this page and are NOT
  confirmed by the decree article — confirm against the decree text / MICI / Migración, or delete.
*/}
<VisaPage
  lang="en"
  title="Panama Qualified Investor Visa (Decree 17 of 2026) — Golden Visa"
  description="Panama's Qualified Investor permanent residency under Executive Decree 17 of 2026: $300K new-build, $500K resale, securities and deposit routes, timelines and special passport."
  visaName="Panama Qualified Investor Visa"
  tag="Golden Visa · Investors"
  tagColor="bg-gold/30 text-slate font-bold"
  mainReq="Qualifying investment in Panama (Decree 17 of 2026)"
  investment="$300,000 (first-sale property) · $500,000 (secondary-market property or securities) · $750,000 (private-bank time deposit)"
  processingTime="MICI certificate up to 15 business days + immigration resolution up to 30 business days"
  renewalNote="Permanent residency · investment maintained for the period set by regulation (5 years)"
  quickAnswer="Panama's Qualified Investor category grants permanent residency in exchange for a qualifying investment. Since Executive Decree No. 17 of 2026 (in force 16 September 2026, replacing Decree 722 of 2020), the minimum is B/.300,000 for a first-sale property (new, unoccupied) and B/.500,000 for secondary-market property; B/.500,000 in securities; B/.750,000 in private-bank time deposits, with a special B/.500,000 threshold for certain deposits at Banco Nacional or Caja de Ahorros. The decree sets up to 15 business days for the MICI investment certificate and up to 30 business days for the immigration resolution. Origin and traceability of funds must be documented, and the investment must be maintained for the regulated period (five years)."
  intro="Permanent residency in exchange for a qualifying investment. Executive Decree No. 17 of 2026 replaced the earlier regime and introduced a key distinction: not every US$300,000 property qualifies — first-sale (new, unoccupied) property starts at B/.300,000, while secondary-market property starts at B/.500,000. Read our full analysis of the decree before committing capital."
  requirements={[
    "Real estate, first sale: minimum B/.300,000 in a new, unoccupied property, under the conditions of the decree",
    "Real estate, secondary market (previously sold, occupied, leased or transferred): minimum B/.500,000",
    "Pre-construction: purchase agreements for properties under construction can support the investment from B/.300,000, with a trust (fideicomiso) or, in certain cases, full payment to the developer secured by a bank guarantee until the property is built, registered and titled",
    "Securities market: minimum B/.500,000 in the instruments and conditions set by regulation",
    "Time deposits: minimum B/.750,000 in private banks; special B/.500,000 threshold for certain deposits at Banco Nacional de Panamá or Caja de Ahorros",
    "Documented origin, traceability and ownership of the funds — plan the paperwork before investing",
    "Investment maintained for the regulated period (five years), with verification and substitution/reinvestment provisions where applicable",
    // [VERIFICAR] document list below comes from the previous page version; confirm it still applies under Decree 17 of 2026
    "Valid passport, apostilled criminal background check and apostilled civil documents (birth certificate; marriage certificate if applicable)",
    // [VERIFICAR] medical exam requirement and apostille/sworn-translation rules
    "Foreign documents apostilled and translated by an Authorized Public Translator in Panama"
  ]}
  benefits={[
    "Permanent residency category — no periodic renewal of the residency status itself",
    "Defined timelines: MICI Investment Certificate up to 15 business days; immigration resolution up to 30 business days",
    "Eligibility for the special passport created by Law 493 of 28 October 2025, for permanent residents under this category and their dependents once requirements are met. It is not Panamanian citizenship and does not replace your own passport",
    // [VERIFICAR] 'spouse and children as dependents' — decree article only says 'dependents'; confirm who qualifies
    "Dependents can be included (confirm who qualifies for your family)",
    // [VERIFICAR] 'territorial taxation' — true of Panama's regime generally, but confirm wording with a tax advisor before promoting it as a visa benefit
    "Panama's territorial tax system generally taxes only Panama-source income — see our territorial tax guide and confirm your situation with a tax advisor"
  ]}
  notFor={[
    "You expect any US$300,000 property to qualify — resale (secondary-market) property needs B/.500,000",
    "You are not prepared to hold the investment for the required period",
    "You cannot document the origin and traceability of the funds",
    "You want flexibility without locking up capital — compare the Friendly Nations visa"
  ]}
  faqs={[
    {
      q: "What changed with Executive Decree No. 17 of 2026?",
      a: "The decree, in force since 16 September 2026, fully replaces Executive Decree No. 722 of 2020. For real estate it distinguishes first-sale property (from B/.300,000) from secondary-market property (from B/.500,000), sets timelines for the process and reinforces proof of origin and traceability of funds."
    },
    {
      q: "What are the investment options?",
      a: "Real estate (B/.300,000 first sale; B/.500,000 secondary market), securities (B/.500,000), and time deposits (B/.750,000 in private banks, with a special B/.500,000 threshold for certain deposits at Banco Nacional or Caja de Ahorros). Pre-construction purchases can support the investment from B/.300,000 under trust or bank-guarantee conditions."
    },
    {
      q: "How long does the process take?",
      a: "The decree sets up to 15 business days for the MICI Investment Certificate and up to 30 business days for the immigration resolution. Total time also depends on how quickly your documents and funds are in order."
    },
    {
      q: "Does the special passport make me a Panamanian citizen?",
      a: "No. The special passport, enabled by Law 493 of 28 October 2025, is not citizenship and does not replace your ordinary passport. It is available to permanent residents under the Qualified Investor category and their dependents once the legal requirements are met."
    },
    {
      q: "Can I apply remotely or include family members?",
      a: "Dependents can be included, and many steps are commonly handled through a Panamanian attorney under power of attorney. Exact rules on who qualifies as a dependent and which steps require your presence should be confirmed with your attorney for your case."
      // [VERIFICAR] previous page claimed 100% remote processing with a single trip, and listed parents/children up to 25 as dependents with extra fees. Not confirmed by the decree article.
    }
  ]}
>
  <div class="my-8 p-5 rounded-2xl bg-coral/10 border border-coral/20">
    <p class="font-semibold text-slate mb-2">Updated for Decree 17 of 2026</p>
    <p class="text-sm text-slate-mid">This page reflects Executive Decree No. 17 of 2026 as summarised in <a href="/en/blog/qualified-investor-decree-2026/" class="text-jade underline">our decree analysis</a>. It is general information, not legal advice. Confirm the current requirements with the competent authorities or a Panamanian immigration attorney before investing.</p>
  </div>
  <div class="mt-2 p-5 rounded-2xl bg-fog border border-jade/15">
    <p class="text-xs font-semibold text-slate-mid uppercase tracking-widest mb-3">Related guides</p>
    <div class="space-y-2">
      <a href="/en/blog/qualified-investor-decree-2026/" class="flex items-center gap-2 text-jade text-sm hover:underline">
        <span>→</span>
        <span>Decree 17 of 2026 explained — first sale vs. secondary market</span>
      </a>
      <a href="/en/real-estate/" class="flex items-center gap-2 text-jade text-sm hover:underline">
        <span>→</span>
        <span>Real estate in Panama — price ranges by area and the buying process</span>
      </a>
      <a href="/en/visas/friendly-nations/" class="flex items-center gap-2 text-jade text-sm hover:underline">
        <span>→</span>
        <span>Friendly Nations Visa — an alternative if you prefer not to lock up capital</span>
      </a>
    </div>
  </div>
</VisaPage>
