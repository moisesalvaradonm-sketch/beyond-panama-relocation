---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Contact — Beyond Panama Relocation" description="Have a specific question? Write to us. Response within 24–48 hours." lang="en">
  <section class="max-w-2xl mx-auto px-4 py-16">
    <a href="/en/" class="text-jade text-sm hover:underline">← Home</a>
    <header class="mt-4 mb-10">
      <h1 class="font-serif text-4xl text-slate mb-3">Contact</h1>
      <p class="text-slate-mid text-lg">The quiz answers most questions. If you have something more specific, write to us — we respond within 24 to 48 hours.</p>
    </header>
    <div class="p-5 rounded-2xl bg-jade/5 border border-jade/15 mb-8 flex gap-4 items-start">
      <span class="text-2xl">💡</span>
      <div>
        <p class="font-medium text-slate text-sm mb-1">Is it a question about visas, areas or cost of living?</p>
        <p class="text-sm text-slate-mid mb-2">The quiz probably guides you better than an email.</p>
        <a href="/en/quiz" class="text-jade text-sm font-medium hover:underline">Take the quiz →</a>
      </div>
    </div>
    <form
      class="space-y-5"
      name="contact"
      method="post"
      data-netlify="true"
      netlify-honeypot="bot-field"
      action="/en/contact?sent=1"
    >
      <input type="hidden" name="form-name" value="contact" />
      <p hidden><input name="bot-field" /></p>
      <div>
        <label for="name" class="block text-sm font-medium text-slate mb-1">Name</label>
        <input type="text" id="name" name="name" required placeholder="Your name" class="w-full px-4 py-3 rounded-xl border border-jade/20 bg-white text-slate placeholder-slate-mid/40 focus:outline-none focus:border-jade text-sm" />
      </div>
      <div>
        <label for="email" class="block text-sm font-medium text-slate mb-1">Email</label>
        <input type="email" id="email" name="email" required placeholder="you@email.com" class="w-full px-4 py-3 rounded-xl border border-jade/20 bg-white text-slate placeholder-slate-mid/40 focus:outline-none focus:border-jade text-sm" />
      </div>
      <div>
        <label for="topic" class="block text-sm font-medium text-slate mb-1">What are you looking for?</label>
        <select id="topic" name="topic" class="w-full px-4 py-3 rounded-xl border border-jade/20 bg-white text-slate focus:outline-none focus:border-jade text-sm">
          <option value="">Select an option...</option>
          <option value="visas">Information about visas</option>
          <option value="property">Looking for a property</option>
          <option value="exploring">Just exploring</option>
          <option value="other">Other</option>
        </select>
      </div>
      <div>
        <label for="message" class="block text-sm font-medium text-slate mb-1">Message</label>
        <textarea id="message" name="message" rows="5" required placeholder="Your question or message..." class="w-full px-4 py-3 rounded-xl border border-jade/20 bg-white text-slate placeholder-slate-mid/40 focus:outline-none focus:border-jade text-sm resize-none"></textarea>
      </div>
      <button type="submit" class="w-full px-6 py-3 rounded-xl bg-jade text-white font-medium text-sm hover:bg-jade-dark transition-colors">Send message</button>
    </form>
    <p class="mt-6 text-xs text-slate-mid/70 text-center leading-relaxed">
      We are not lawyers or a real estate agency. We only offer orientation — never legal advice or guaranteed results.
    </p>
    {Astro.url.searchParams.get('sent') && (
      <div class="mt-6 p-5 rounded-xl bg-jade/10 border border-jade/20 text-center">
        <p class="font-medium text-jade text-sm">✓ Message received — we'll respond within 24 to 48 hours.</p>
      </div>
    )}
  </section>
</Layout>
