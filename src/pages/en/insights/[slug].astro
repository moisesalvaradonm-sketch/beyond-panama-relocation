---
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('insights', ({ data, id }) =>
    !data.draft && data.lang === 'en' && id.startsWith('en/')
  );
  return posts.map(post => ({
    params: { slug: post.id.replace('en/', '') },
    props: { post, allPosts: posts },
  }));
}

const { post, allPosts } = Astro.props;
const { Content } = await render(post);

const categoryLabel: Record<string, string> = {
  'real-estate': 'Market Watch',
  legal: 'Legal Corner',
  finance: 'Finance Desk',
  lifestyle: 'Panama Living',
  'client-story': 'Expat Voices',
  'moving-guide': 'Moving Guide',
};

const categoryColor: Record<string, string> = {
  'real-estate': 'bg-amber-50 text-amber-700',
  legal: 'bg-blue-50 text-blue-700',
  finance: 'bg-emerald-50 text-emerald-700',
  lifestyle: 'bg-violet-50 text-violet-700',
  'client-story': 'bg-jade/8 text-jade',
  'moving-guide': 'bg-sky-50 text-sky-700',
};

const related = allPosts
  .filter(p => p.id !== post.id && p.data.category === post.data.category)
  .slice(0, 2)
  .concat(
    allPosts
      .filter(p => p.id !== post.id && p.data.category !== post.data.category)
      .slice(0, Math.max(0, 2 - allPosts.filter(p => p.id !== post.id && p.data.category === post.data.category).length))
  )
  .slice(0, 2);

const pageUrl = Astro.url.href;
const shareTitle = encodeURIComponent(post.data.title);
const shareUrl = encodeURIComponent(pageUrl);
const twitterUrl = `https://twitter.com/intent/tweet?text=${shareTitle}&url=${shareUrl}`;
const whatsappUrl = `https://wa.me/?text=${shareTitle}%20${shareUrl}`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  url: pageUrl,
  inLanguage: 'en',
  author: {
    '@type': 'Person',
    name: post.data.authorName,
    ...(post.data.authorWebsite ? { sameAs: [post.data.authorWebsite] } : {}),
  },
  publisher: {
    '@type': 'Organization',
    name: 'Beyond Panama Relocation',
    url: 'https://beyondpanamarelocation.com',
  },
};
---

<Layout
  title={post.data.title}
  description={post.data.description}
  lang="en"
  pubDate={post.data.pubDate}
  articleAuthor={post.data.authorName}
  articleSection={categoryLabel[post.data.category] ?? post.data.category}
>
  <article class="max-w-3xl mx-auto px-4 py-16">

    <a href="/en/insights" class="inline-flex items-center gap-1 text-jade text-sm hover:underline mb-8">
      ← Beyond Insights
    </a>

    {post.data.image && (
      <div class="rounded-2xl overflow-hidden mb-10 -mx-4 sm:mx-0 h-64 sm:h-80">
        <img
          src={post.data.image}
          alt={post.data.imageAlt ?? post.data.title}
          class="w-full h-full object-cover"
          loading="eager"
        />
      </div>
    )}

    <header class="mt-4 mb-10">
      <span class={`inline-block px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wide mb-3 ${categoryColor[post.data.category] ?? 'bg-slate/5 text-slate-mid'}`}>
        {categoryLabel[post.data.category] ?? post.data.category}
      </span>
      <h1 class="font-serif text-4xl text-slate mt-2 mb-3 leading-snug">{post.data.title}</h1>
      <p class="text-slate-mid text-lg leading-relaxed mb-6">{post.data.description}</p>

      <!-- Author card -->
      <div class="flex items-start gap-4 p-4 rounded-xl bg-slate/3 border border-jade/8">
        {post.data.authorAvatar ? (
          <img
            src={post.data.authorAvatar}
            alt={post.data.authorName}
            class="w-12 h-12 rounded-full object-cover flex-shrink-0"
          />
        ) : (
          <div class="w-12 h-12 rounded-full bg-jade/12 flex items-center justify-center flex-shrink-0">
            <span class="text-jade text-lg font-semibold">{post.data.authorName.charAt(0)}</span>
          </div>
        )}
        <div>
          <p class="font-semibold text-slate text-sm">{post.data.authorName}</p>
          <p class="text-xs text-jade mb-1">{post.data.authorRole}</p>
          {post.data.authorBio && (
            <p class="text-xs text-slate-mid leading-relaxed">{post.data.authorBio}</p>
          )}
        </div>
      </div>

      <div class="flex flex-wrap gap-4 text-xs text-slate-mid mt-4">
        <span>{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
        <span>·</span>
        <span>{post.data.readTime} min read</span>
      </div>
    </header>

    <!-- Content -->
    <div class="prose prose-slate max-w-none
      prose-headings:font-serif prose-headings:text-slate
      prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-4
      prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3
      prose-p:text-slate-mid prose-p:leading-relaxed
      prose-li:text-slate-mid
      prose-strong:text-slate
      prose-a:text-jade prose-a:no-underline hover:prose-a:underline
      prose-hr:border-jade/10">
      <Content />
    </div>

    <!-- Share -->
    <div class="mt-12 pt-8 border-t border-jade/10 flex items-center gap-4">
      <span class="text-xs text-slate-mid font-medium uppercase tracking-wide">Share</span>
      <a href={twitterUrl} target="_blank" rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-jade/15 text-sm text-slate-mid hover:border-jade hover:text-jade transition-colors">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.26 5.632 5.903-5.632zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        X / Twitter
      </a>
      <a href={whatsappUrl} target="_blank" rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-jade/15 text-sm text-slate-mid hover:border-jade hover:text-jade transition-colors">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12.004 0C5.372 0 0 5.373 0 12.004c0 2.117.554 4.1 1.523 5.823L0 24l6.335-1.498A11.955 11.955 0 0012.004 24C18.627 24 24 18.628 24 12.004 24 5.373 18.627 0 12.004 0zm0 21.818a9.81 9.81 0 01-5.001-1.373l-.36-.214-3.726.88.945-3.617-.235-.372A9.795 9.795 0 012.182 12.004c0-5.42 4.41-9.818 9.822-9.818 5.42 0 9.814 4.398 9.814 9.818 0 5.412-4.394 9.814-9.814 9.814z"/></svg>
        WhatsApp
      </a>
    </div>

    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

    {(post.data.authorWebsite || post.data.authorPhone) && (
      <div class="mt-12 p-6 rounded-2xl border border-jade/15 bg-white flex flex-col sm:flex-row items-center gap-5 sm:gap-6">
        <div class="flex-1 text-center sm:text-left">
          <p class="font-serif text-lg text-slate mb-1">Need help with your documents?</p>
          <p class="text-sm text-slate-mid">Get in touch directly with {post.data.authorName} — {post.data.authorRole}.</p>
        </div>
        <div class="flex gap-3 flex-shrink-0">
          {post.data.authorWebsite && (
            <a href={post.data.authorWebsite} target="_blank" rel="noopener noreferrer"
              class="inline-flex px-5 py-2.5 rounded-full bg-jade text-white text-sm font-medium hover:bg-jade-dark transition-colors">
              Website →
            </a>
          )}
          {post.data.authorPhone && (
            <a href={`tel:${post.data.authorPhone}`}
              class="inline-flex px-5 py-2.5 rounded-full border border-jade/30 text-jade text-sm font-medium hover:bg-jade/5 transition-colors">
              Call
            </a>
          )}
        </div>
      </div>
    )}

    <!-- CTA -->
    <div class="mt-12 p-8 rounded-2xl bg-jade/5 border border-jade/15 text-center">
      <p class="font-serif text-xl text-slate mb-2">Ready for your next step?</p>
      <p class="text-slate-mid text-sm mb-5">Take the quiz to get a personalized relocation route in 2 minutes.</p>
      <a href="/en/quiz" class="inline-flex px-6 py-3 rounded-full bg-jade text-white font-medium text-sm hover:bg-jade-dark transition-colors">
        Take the quiz →
      </a>
    </div>

    <!-- Related -->
    {related.length > 0 && (
      <aside class="mt-16">
        <h2 class="font-serif text-2xl text-slate mb-6">More from Beyond Insights</h2>
        <div class="grid sm:grid-cols-2 gap-5">
          {related.map(rel => (
            <a
              href={`/en/insights/${rel.id.replace('en/', '')}`}
              class="group p-5 rounded-2xl bg-white border border-jade/10 hover:border-jade/25 hover:shadow-sm transition-all"
            >
              <span class={`text-xs font-semibold uppercase tracking-wide ${rel.data.category === 'client-story' ? 'text-jade' : 'text-slate-mid'}`}>
                {categoryLabel[rel.data.category] ?? rel.data.category}
              </span>
              <h3 class="font-serif text-base font-semibold text-slate mt-2 mb-2 leading-snug group-hover:text-jade transition-colors">
                {rel.data.title}
              </h3>
              <p class="text-xs text-slate-mid mb-3">{rel.data.authorName} · {rel.data.authorRole.split('·')[0].trim()}</p>
              <span class="text-xs text-jade font-medium">Read → {rel.data.readTime} min</span>
            </a>
          ))}
        </div>
      </aside>
    )}

  </article>
</Layout>
