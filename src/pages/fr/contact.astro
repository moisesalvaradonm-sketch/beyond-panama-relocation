---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Contact — Beyond Panama Relocation" description="Vous avez une question spécifique ? Écrivez-nous. Nous répondons en 24–48 heures." lang="fr">
  <section class="max-w-2xl mx-auto px-4 py-16">
    <a href="/fr/" class="text-jade text-sm hover:underline">← Accueil</a>
    <header class="mt-4 mb-10">
      <h1 class="font-serif text-4xl text-slate mb-3">Contact</h1>
      <p class="text-slate-mid text-lg">Votre route répond à la plupart des questions. Si vous avez quelque chose de plus spécifique, écrivez-nous — nous répondons en 24 à 48 heures.</p>
    </header>
    <div class="p-5 rounded-2xl bg-jade/5 border border-jade/15 mb-8 flex gap-4 items-start">
      <span class="text-2xl">💡</span>
      <div>
        <p class="font-medium text-slate text-sm mb-1">Vous avez une question sur les visas, les zones ou le coût de la vie ?</p>
        <p class="text-sm text-slate-mid mb-2">Votre route vous guidera probablement mieux qu'un e-mail.</p>
        <a href="/fr/quiz" class="text-jade text-sm font-medium hover:underline">Trouver ma route →</a>
      </div>
    </div>
    <form
      class="space-y-5"
      name="contact-fr"
      method="post"
      data-netlify="true"
      netlify-honeypot="bot-field"
      action="/fr/contact?envoye=1"
    >
      <input type="hidden" name="form-name" value="contact-fr" />
      <p hidden><input name="bot-field" /></p>
      <div>
        <label for="nom" class="block text-sm font-medium text-slate mb-1">Nom</label>
        <input type="text" id="nom" name="nom" required placeholder="Votre nom" class="w-full px-4 py-3 rounded-xl border border-jade/20 bg-white text-slate placeholder-slate-mid/40 focus:outline-none focus:border-jade text-sm" />
      </div>
      <div>
        <label for="email" class="block text-sm font-medium text-slate mb-1">Adresse e-mail</label>
        <input type="email" id="email" name="email" required placeholder="vous@email.com" class="w-full px-4 py-3 rounded-xl border border-jade/20 bg-white text-slate placeholder-slate-mid/40 focus:outline-none focus:border-jade text-sm" />
      </div>
      <div>
        <label for="sujet" class="block text-sm font-medium text-slate mb-1">Que cherchez-vous ?</label>
        <select id="sujet" name="sujet" class="w-full px-4 py-3 rounded-xl border border-jade/20 bg-white text-slate focus:outline-none focus:border-jade text-sm">
          <option value="">Sélectionnez une option...</option>
          <option value="visas">Informations sur les visas</option>
          <option value="propriete">Je cherche un bien immobilier</option>
          <option value="exploration">J'explore les options</option>
          <option value="autre">Autre</option>
        </select>
      </div>
      <div>
        <label for="message" class="block text-sm font-medium text-slate mb-1">Message</label>
        <textarea id="message" name="message" rows="5" required placeholder="Votre question ou message..." class="w-full px-4 py-3 rounded-xl border border-jade/20 bg-white text-slate placeholder-slate-mid/40 focus:outline-none focus:border-jade text-sm resize-none"></textarea>
      </div>
      <button type="submit" class="w-full px-6 py-3 rounded-xl bg-jade text-white font-medium text-sm hover:bg-jade-dark transition-colors">
        Envoyer le message
      </button>
    </form>
    <p class="mt-6 text-xs text-slate-mid/70 text-center leading-relaxed">
      Nous ne sommes ni avocats ni agence immobilière. Nous vous orientons seulement — jamais de conseil juridique ni de promesses de résultats.
    </p>
    {Astro.url.searchParams.get('envoye') && (
      <div class="mt-6 p-5 rounded-xl bg-jade/10 border border-jade/20 text-center">
        <p class="font-medium text-jade text-sm">✓ Message reçu — nous répondons en 24 à 48 heures.</p>
      </div>
    )}
  </section>
</Layout>
