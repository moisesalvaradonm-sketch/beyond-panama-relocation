---
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../components/ui/ContactForm';
---

<Layout title="Contact" description="Écrivez-nous pour planifier votre installation au Panama. WhatsApp, e-mail ou formulaire — nous répondons en 24 heures." lang="fr">
  <section class="max-w-4xl mx-auto px-4 py-16">
    <div class="mb-10">
      <a href="/fr/" class="text-jade text-sm hover:underline">← Accueil</a>
      <h1 class="font-serif text-4xl text-slate mt-4 mb-3">Parlons de votre installation au Panama</h1>
      <p class="text-slate-mid text-lg max-w-2xl">
        Pas de réponses automatiques, pas de tunnel de vente. Vous parlerez à une vraie personne qui a vécu ce processus — généralement en moins d'une journée.
      </p>
    </div>

    <!-- 3 façons de nous contacter -->
    <div class="space-y-6 mb-14">

      <!-- WhatsApp — CTA principal -->
      <div class="rounded-2xl bg-jade/5 border border-jade/25 p-8 flex flex-col sm:flex-row sm:items-center gap-6">
        <div class="flex-1">
          <span class="text-xs font-semibold text-jade uppercase tracking-wide">La meilleure façon de nous contacter</span>
          <h2 class="font-serif text-2xl text-slate mt-1 mb-2">WhatsApp</h2>
          <p class="text-slate-mid text-sm max-w-md">
            Envoyez un message rapide avec votre situation et vos questions. Nous répondons le jour même (lun–ven) et voyons ensemble si nous pouvons vous aider avant tout autre chose.
          </p>
        </div>
        <a
          href="https://wa.me/50760844256"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-7 py-4 rounded-full bg-jade text-white font-medium text-base hover:bg-jade-dark transition-colors shrink-0"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Écrivez-nous sur WhatsApp
        </a>
      </div>

      <!-- E-mail -->
      <div class="rounded-2xl bg-white border border-jade/10 p-6 flex flex-col sm:flex-row sm:items-center gap-4">
        <div class="flex-1">
          <span class="text-xs font-semibold text-jade uppercase tracking-wide">E-mail</span>
          <h2 class="font-serif text-xl text-slate mt-1 mb-1">Vous préférez l'e-mail ?</h2>
          <p class="text-slate-mid text-sm">Idéal pour les questions plus longues ou si vous souhaitez joindre des documents.</p>
        </div>
        <a
          href="mailto:contact@beyondpanamarelocation.com"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-jade/25 text-jade font-medium text-sm hover:bg-jade/5 transition-colors shrink-0"
        >
          contact@beyondpanamarelocation.com
        </a>
      </div>

      <!-- Appel vidéo — bientôt -->
      <div class="rounded-2xl bg-white border border-jade/10 p-6 flex flex-col sm:flex-row sm:items-center gap-4 opacity-70">
        <div class="flex-1">
          <span class="text-xs font-semibold text-jade uppercase tracking-wide">Appel vidéo</span>
          <h2 class="font-serif text-xl text-slate mt-1 mb-1">Planifier un appel</h2>
          <p class="text-slate-mid text-sm">Consultation de 30 minutes par Zoom ou Google Meet. Commencez par WhatsApp et nous fixerons un horaire.</p>
        </div>
        <span class="inline-flex items-center px-5 py-3 rounded-full border border-jade/15 text-slate-mid text-sm shrink-0">
          Calendly bientôt disponible
        </span>
      </div>

    </div>

    <!-- Formulaire de contact -->
    <div class="mb-14">
      <h2 class="font-serif text-2xl text-slate mb-2">Ou envoyez-nous un message directement</h2>
      <p class="text-slate-mid text-sm mb-6">Remplissez le formulaire et nous vous répondrons dans les 24 heures.</p>
      <ContactForm lang="fr" client:load />
    </div>

    <!-- Ce à quoi s'attendre -->
    <div class="mb-14 rounded-2xl bg-jade/5 border border-jade/15 p-8">
      <h2 class="font-serif text-2xl text-slate mb-6">Ce qui se passe après votre message</h2>
      <ul class="space-y-4">
        <li class="flex gap-4">
          <span class="text-jade font-serif text-xl leading-none mt-0.5">1</span>
          <div>
            <p class="text-slate font-medium">Vous recevrez une réponse en moins de 24 heures</p>
            <p class="text-slate-mid text-sm mt-0.5">Généralement bien plus tôt. Nous lisons chaque message personnellement et répondons le jour même en semaine.</p>
          </div>
        </li>
        <li class="flex gap-4">
          <span class="text-jade font-serif text-xl leading-none mt-0.5">2</span>
          <div>
            <p class="text-slate font-medium">La première conversation est gratuite — toujours</p>
            <p class="text-slate-mid text-sm mt-0.5">Nous comprenons votre situation, répondons à vos premières questions et vous disons honnêtement si nous pouvons vous aider.</p>
          </div>
        </li>
        <li class="flex gap-4">
          <span class="text-jade font-serif text-xl leading-none mt-0.5">3</span>
          <div>
            <p class="text-slate font-medium">Sans pression, sans vente agressive</p>
            <p class="text-slate-mid text-sm mt-0.5">Si nous ne sommes pas la bonne option pour votre situation, nous vous l'indiquons et vous orientons vers des ressources adaptées.</p>
          </div>
        </li>
      </ul>
    </div>

    <!-- Nudge final -->
    <div class="text-center p-8 rounded-2xl bg-jade/5 border border-jade/15">
      <p class="font-serif text-xl text-slate mb-2">Vous ne savez pas par où commencer ?</p>
      <p class="text-slate-mid text-sm mb-5">Faites le quiz rapide et nous vous indiquons quelle route correspond le mieux à votre situation.</p>
      <a href="/fr/quiz/" class="inline-flex px-6 py-3 rounded-full bg-jade text-white font-medium text-sm hover:bg-jade-dark transition-colors">
        Trouver ma route →
      </a>
    </div>
  </section>
</Layout>
