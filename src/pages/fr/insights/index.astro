---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

const posts = await getCollection('insights', ({ data, id }) =>
  !data.draft && data.lang === 'fr' && id.startsWith('fr/')
);
posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const categoryLabel: Record<string, string> = {
  'real-estate': 'Veille Marché',
  legal: 'Le Coin Juridique',
  finance: 'Regard Financier',
  lifestyle: 'Vivre au Panama',
  'client-story': 'Voix d\'Expats',
  'moving-guide': 'Guide de Déménagement',
};

const categoryColor: Record<string, string> = {
  'real-estate': 'bg-amber-50 text-amber-700 border-amber-200',
  legal: 'bg-blue-50 text-blue-700 border-blue-200',
  finance: 'bg-emerald-50 text-emerald-700 border-emerald-200',
  lifestyle: 'bg-violet-50 text-violet-700 border-violet-200',
  'client-story': 'bg-jade/8 text-jade border-jade/20',
  'moving-guide': 'bg-sky-50 text-sky-700 border-sky-200',
};
---

<Layout
  title="Beyond Insights — Perspectives d'experts sur la vie au Panama"
  description="Des voix authentiques du terrain : agents immobiliers, avocats, conseillers et clients partagent leur expérience directe de la relocalisation au Panama."
  lang="fr"
>
  <section class="max-w-4xl mx-auto px-4 py-16">

    <div class="mb-12">
      <a href="/fr/" class="text-jade text-sm hover:underline">← Accueil</a>
      <div class="mt-4 mb-6">
        <p class="text-xs font-semibold text-jade uppercase tracking-widest mb-2">Beyond Insights</p>
        <h1 class="font-serif text-4xl text-slate mb-3">Perspectives d'Experts sur le Panama</h1>
        <p class="text-slate-mid text-lg max-w-2xl leading-relaxed">
          Des voix de première main de notre réseau : agents immobiliers, avocats en immigration, conseillers financiers et clients ayant déjà effectué leur déménagement. Sélectionné, pas sponsorisé.
        </p>
      </div>

      <div class="flex flex-wrap gap-2">
        {Object.entries(categoryLabel).map(([key, label]) => (
          <span class={`px-3 py-1 rounded-full text-xs font-medium border ${categoryColor[key] ?? 'bg-slate/5 text-slate-mid border-slate/10'}`}>
            {label}
          </span>
        ))}
      </div>
    </div>

    <!-- Bannière à venir — toujours visible -->
    <div class="mb-10 p-6 rounded-2xl border border-jade/15 bg-gradient-to-br from-jade/4 to-transparent flex flex-col sm:flex-row items-start sm:items-center gap-4">
      <div class="text-2xl">📬</div>
      <div>
        <p class="font-semibold text-slate text-sm mb-0.5">Restez à l'écoute — premières publications bientôt</p>
        <p class="text-xs text-slate-mid leading-relaxed">Nous sélectionnons des contributions de notre réseau d'agents, d'avocats, de conseillers et de clients installés au Panama. Expérience réelle, sans remplissage.</p>
      </div>
    </div>

    {posts.length > 0 ? (
      <div class="grid gap-8">
        {posts.map(post => (
          <a href={`/fr/insights/${post.id.replace('fr/', '')}`}
            class="group flex flex-col sm:flex-row gap-6 p-6 rounded-2xl bg-white border border-jade/10 hover:border-jade/25 hover:shadow-sm transition-all">
            {post.data.image && (
              <div class="sm:w-48 h-36 sm:h-auto flex-shrink-0 rounded-xl overflow-hidden">
                <img src={post.data.image} alt={post.data.imageAlt ?? post.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              </div>
            )}
            <div class="flex flex-col flex-1 min-w-0">
              <div class="flex flex-wrap items-center gap-2 mb-3">
                <span class={`px-2.5 py-0.5 rounded-full text-xs font-semibold border ${categoryColor[post.data.category] ?? 'bg-slate/5 text-slate-mid border-slate/10'}`}>
                  {categoryLabel[post.data.category] ?? post.data.category}
                </span>
                <span class="text-xs text-slate-mid">{post.data.readTime} min de lecture</span>
              </div>
              <h2 class="font-serif text-xl font-semibold text-slate mb-2 leading-snug group-hover:text-jade transition-colors">{post.data.title}</h2>
              <p class="text-sm text-slate-mid mb-4 line-clamp-2 flex-1">{post.data.description}</p>
              <div class="flex items-center gap-3 mt-auto pt-3 border-t border-jade/8">
                <div class="w-8 h-8 rounded-full bg-jade/10 flex items-center justify-center flex-shrink-0">
                  <span class="text-jade text-sm font-semibold">{post.data.authorName.charAt(0)}</span>
                </div>
                <div class="min-w-0">
                  <p class="text-xs font-semibold text-slate truncate">{post.data.authorName}</p>
                  <p class="text-xs text-slate-mid truncate">{post.data.authorRole}</p>
                </div>
                <span class="ml-auto text-jade text-sm font-medium flex-shrink-0">Lire →</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="text-center py-16 text-slate-mid">
        <p class="font-serif text-xl text-slate mb-2">Bientôt disponible</p>
        <p class="text-sm">Les perspectives d'experts seront publiées ici prochainement.</p>
        <p class="text-sm mt-2">En attendant, les articles sont disponibles en anglais.</p>
        <a href="/en/insights" class="inline-flex mt-4 px-5 py-2 rounded-full border border-jade text-jade text-sm hover:bg-jade hover:text-white transition-colors">
          Voir en anglais →
        </a>
      </div>
    )}

    <div class="mt-16 p-8 rounded-2xl bg-jade/5 border border-jade/15 text-center">
      <p class="font-serif text-xl text-slate mb-2">Vous êtes partenaire, conseiller ou client ?</p>
      <p class="text-slate-mid text-sm mb-5">Si vous avez une expérience réelle de la relocalisation au Panama et souhaitez partager votre perspective, contactez-nous.</p>
      <a href="/fr/contact" class="inline-flex px-6 py-3 rounded-full bg-jade text-white font-medium text-sm hover:bg-jade-dark transition-colors">
        Nous contacter →
      </a>
    </div>

  </section>
</Layout>
