---
import Layout from '../../layouts/Layout.astro';
import ReviewsCarousel from '../../components/ui/ReviewsCarousel.astro';
import { getCollection } from 'astro:content';

const recentPosts = (await getCollection('blog', ({ data, id }) =>
  !data.draft && data.lang === 'fr' && id.startsWith('fr/')
))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const categoryLabel: Record<string, string> = {
  zonas: 'Régions & Vie',
  visas: 'Visas & Résidence',
  'costo-de-vida': 'Coût de la Vie',
  proceso: 'Processus',
  lifestyle: 'Style de Vie',
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Le Panama utilise-t-il le dollar américain ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Oui. La monnaie officielle du Panama est le dollar américain — il n'existe pas de taux de change local ni de risque de conversion de devises. Cela facilite considérablement la gestion d'un budget pour quiconque perçoit des revenus en USD, et constitue l'une des principales raisons pour lesquelles le pays attire en permanence des retraités, des travailleurs à distance et des investisseurs d'Amérique du Nord et d'Europe.",
      },
    },
    {
      '@type': 'Question',
      name: 'Quels visas de résidence le Panama propose-t-il aux étrangers ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Le Panama offre plusieurs voies de résidence selon votre situation. Le visa Pensionado est conçu pour les retraités percevant une pension viagère d'au moins 1 000 USD/mois — il octroie la résidence permanente et un large catalogue de réductions légales. Le visa Nations Amies cible les ressortissants de 50 pays ayant des liens économiques avec le Panama. Le visa Investisseur Qualifié requiert un investissement financier qualifié. Le visa Nomade Digital est destiné aux travailleurs à distance percevant des revenus hors du Panama. Beyond Panama Relocation couvre chaque visa avec ses conditions, ses délais et une comparaison détaillée.",
      },
    },
    {
      '@type': 'Question',
      name: 'Combien coûte la vie au Panama par mois ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Le coût de la vie au Panama varie de 1 200 à plus de 5 000 USD par mois selon la région et le mode de vie. Un couple vivant simplement à Boquete — une ville de montagne très prisée — peut vivre avec environ 1 620 USD/mois, couvrant loyer, alimentation, charges, assurance santé, internet et transports. Les coûts à Panama City seront sensiblement plus élevés. Le Panama est généralement 30 à 50 % moins cher qu'un mode de vie équivalent aux États-Unis.",
      },
    },
    {
      '@type': 'Question',
      name: 'Quelles sont les régions les plus populaires pour les expatriés au Panama ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Les régions les plus prisées des résidents étrangers au Panama sont : Panama City (la capitale, offrant la plus grande diversité de services et de prix), Boquete (une ville de montagne au climat frais et à la communauté d'expatriés bien établie), Coronado (une station balnéaire du Pacifique appréciée des retraités) et Bocas del Toro (un archipel caribéen au style de vie détendu). Chaque région présente un profil distinct en termes de coût, de communauté et d'infrastructure.",
      },
    },
  ],
};
---

<Layout
  title="Guide de Relocation au Panama"
  description="Informations honnêtes sur les visas, les régions et le coût de la vie au Panama. Pour les expatriés qui veulent prendre une décision éclairée."
  lang="fr"
>

  <!-- Hero -->
  <section class="relative text-white overflow-hidden min-h-[90vh] flex items-center">
    <!-- Background photo -->
    <img
      src="/img/panama-hero.webp"
      alt="Vue aérienne de la Cinta Costera de Panama City et l'océan Pacifique"
      class="absolute inset-0 w-full h-full object-cover object-center"
      width="3964"
      height="4955"
      fetchpriority="high"
    />
    <!-- Gradient overlay: dark top-left + gradient to right -->
    <div class="absolute inset-0 bg-gradient-to-r from-slate/90 via-slate/70 to-slate/30"></div>
    <!-- Bottom fade for smooth transition -->
    <div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-fog/30 to-transparent"></div>

    <div class="relative z-10 max-w-6xl mx-auto px-6 md:px-8 py-28 md:py-40 w-full">
      <span class="block text-gold text-xs tracking-[0.25em] uppercase font-medium mb-6">
        Beyond Panama Relocation
      </span>
      <h1 class="font-serif text-5xl md:text-6xl lg:text-7xl font-semibold leading-[1.05] max-w-3xl mb-8">
        S'installer au Panama,<br />
        <span id="hero-accent" class="text-coral transition-opacity duration-500">sans se tromper.</span>
      </h1>
      <p id="hero-sub" class="text-white/70 text-base md:text-lg max-w-xl leading-relaxed mb-10 transition-opacity duration-500">
        Informations réelles sur les visas, les quartiers et le coût de la vie — sans pression
        commerciale, sans promesses vides. Comme un ami qui l'a déjà fait vous expliquerait les choses.
      </p>
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
        <a
          href="/fr/quiz"
          class="inline-flex items-center gap-2 px-8 py-4 rounded-full bg-gold text-slate font-semibold text-base hover:bg-gold/90 transition-colors shadow-lg"
        >
          Trouvez votre route vers Panama →
        </a>
        <a
          href="/fr/visas"
          class="text-white/60 hover:text-white text-sm underline underline-offset-4 decoration-white/20 hover:decoration-white/60 transition-colors"
        >
          Voir les visas
        </a>
      </div>
      <div class="mt-16 pt-6 border-t border-white/15">
        <p class="text-white/40 text-xs tracking-wide">
          30–50 % moins cher qu'aux États-Unis &nbsp;·&nbsp; 4 types de visa &nbsp;·&nbsp; ES + EN + FR
        </p>
      </div>
    </div>
  </section>

  <!-- Keyword H2 — below hero, before pillars -->
  <section class="max-w-3xl mx-auto px-6 md:px-8 pt-16 pb-2">
    <h2 class="font-serif text-2xl md:text-3xl text-slate leading-snug">
      Votre guide complet pour s'installer au Panama — visas, régions et coût de la vie
    </h2>
  </section>

  <!-- 3 pilliers -->
  <section class="max-w-6xl mx-auto px-6 md:px-8 py-20">
    <h2 class="font-serif text-3xl text-slate mb-14">
      Tout ce qu'il vous faut pour prendre la bonne décision
    </h2>
    <div class="grid md:grid-cols-3 gap-8">

      <a href="/fr/zones" class="group block p-8 bg-white border-l-2 border-jade hover:border-jade-dark transition-colors hover:shadow-sm">
        <p class="font-serif text-5xl text-jade/15 font-bold leading-none mb-4 select-none" aria-hidden="true">01</p>
        <h3 class="font-serif text-xl font-semibold text-slate mb-3">Régions pour Vivre</h3>
        <p class="text-slate-mid text-sm leading-relaxed mb-5">
          Panama City, Boquete, Coronado, Bocas del Toro — comparaisons de prix réels,
          profil de la communauté et qualité de vie.
        </p>
        <span class="text-jade text-sm font-medium group-hover:underline underline-offset-4">
          Explorer les régions →
        </span>
      </a>

      <a href="/fr/visas" class="group block p-8 bg-white border-l-2 border-jade hover:border-jade-dark transition-colors hover:shadow-sm">
        <p class="font-serif text-5xl text-jade/15 font-bold leading-none mb-4 select-none" aria-hidden="true">02</p>
        <h3 class="font-serif text-xl font-semibold text-slate mb-3">Visas &amp; Résidence</h3>
        <p class="text-slate-mid text-sm leading-relaxed mb-5">
          Pensionado, Nations Amies, Investisseur Qualifié, Nomade Digital — lequel correspond
          à votre situation, expliqué sans jargon juridique.
        </p>
        <span class="text-jade text-sm font-medium group-hover:underline underline-offset-4">
          Voir la comparaison →
        </span>
      </a>

      <a href="/fr/cout-de-la-vie" class="group block p-8 bg-white border-l-2 border-jade hover:border-jade-dark transition-colors hover:shadow-sm">
        <p class="font-serif text-5xl text-jade/15 font-bold leading-none mb-4 select-none" aria-hidden="true">03</p>
        <h3 class="font-serif text-xl font-semibold text-slate mb-3">Calculateur de Coût Réel</h3>
        <p class="text-slate-mid text-sm leading-relaxed mb-5">
          Coût du visa + logement + vie quotidienne par région — tout en un seul outil.
          Le chiffre réel, pas celui des brochures.
        </p>
        <span class="text-jade text-sm font-medium group-hover:underline underline-offset-4">
          Calculer mon coût →
        </span>
      </a>

    </div>
  </section>

  <!-- Trust signals — editorial stats -->
  <div class="border-t border-b border-jade/15 py-12">
    <div class="max-w-5xl mx-auto px-6 md:px-8 grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-jade/15">
      <div class="py-8 md:py-0 md:px-10 first:pl-0 last:pr-0">
        <p class="font-serif text-3xl font-semibold text-slate mb-1">$1 200–$5 000</p>
        <p class="text-xs text-slate-mid uppercase tracking-widest">Coût de vie mensuel</p>
      </div>
      <div class="py-8 md:py-0 md:px-10">
        <p class="font-serif text-3xl font-semibold text-slate mb-1">4 types de visa</p>
        <p class="text-xs text-slate-mid uppercase tracking-widest">Options de résidence permanente</p>
      </div>
      <div class="py-8 md:py-0 md:px-10 last:pr-0">
        <p class="font-serif text-3xl font-semibold text-slate mb-1">ES + EN + FR</p>
        <p class="text-xs text-slate-mid uppercase tracking-widest">Tous les guides trilingues</p>
      </div>
    </div>
  </div>

  <!-- Quiz CTA banner -->
  <section class="bg-slate">
    <div class="max-w-3xl mx-auto px-6 md:px-8 py-20 text-center">
      <h2 class="font-serif text-4xl md:text-5xl text-white font-semibold leading-tight mb-5">
        Vous ne savez pas par où commencer ?<br />
        <span class="text-white/50">C'est normal.</span>
      </h2>
      <p class="text-white/50 text-base md:text-lg mb-10 max-w-lg mx-auto leading-relaxed">
        Votre route vous guide en 2 minutes selon ce que vous cherchez vraiment —
        sans engagement.
      </p>
      <a
        href="/fr/quiz"
        class="inline-flex items-center gap-2 px-8 py-4 rounded-full bg-gold text-slate font-semibold text-base hover:bg-gold/90 transition-colors"
      >
        Commencer votre route →
      </a>
      <p class="mt-4 text-white/25 text-xs tracking-wide">Gratuit · 2 minutes · sans inscription</p>
    </div>
  </section>

  <!-- Latest from the Blog -->
  {recentPosts.length > 0 && (
    <section class="max-w-6xl mx-auto px-6 md:px-8 py-20">
      <div class="flex items-end justify-between mb-12">
        <h2 class="font-serif text-3xl text-slate">Du blog</h2>
        <a href="/fr/blog" class="text-jade text-sm font-medium hover:underline underline-offset-4">
          Tous les articles →
        </a>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {recentPosts.map(post => (
          <a
            href={`/fr/blog/${post.id.replace('fr/', '')}`}
            class="group flex flex-col p-6 bg-white border border-jade/10 hover:border-jade/25 hover:shadow-sm transition-all"
          >
            <span class="text-xs font-semibold text-jade uppercase tracking-wide mb-3">
              {categoryLabel[post.data.category] ?? post.data.category}
            </span>
            <h3 class="font-serif text-lg font-semibold text-slate mb-3 leading-snug group-hover:text-jade transition-colors flex-1">
              {post.data.title}
            </h3>
            <p class="text-sm text-slate-mid mb-4 line-clamp-2 leading-relaxed">
              {post.data.description}
            </p>
            <div class="flex items-center justify-between mt-auto">
              <span class="text-xs text-slate-mid">{post.data.readTime} min de lecture</span>
              <span class="text-jade text-sm font-medium group-hover:underline underline-offset-4">Lire →</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- FAQ — optimisé pour IA et People Also Ask -->
  <section class="max-w-3xl mx-auto px-6 md:px-8 py-20">
    <h2 class="font-serif text-3xl text-slate mb-10">Questions fréquentes</h2>
    <dl class="space-y-0">

      <div class="border-b border-jade/10 py-8 pl-5 border-l-4 border-l-jade/30">
        <dt class="font-serif text-xl font-semibold text-slate mb-3">Le Panama utilise-t-il le dollar américain ?</dt>
        <dd class="text-slate-mid leading-relaxed">
          Oui. La monnaie officielle du Panama est le dollar américain — il n'existe pas de taux
          de change local ni de risque de conversion de devises. Cela facilite considérablement
          la gestion d'un budget pour quiconque perçoit des revenus en USD, et constitue l'une des
          principales raisons pour lesquelles le pays attire en permanence des retraités, des
          travailleurs à distance et des investisseurs d'Amérique du Nord et d'Europe.
        </dd>
      </div>

      <div class="border-b border-jade/10 py-8 pl-5 border-l-4 border-l-jade/30">
        <dt class="font-serif text-xl font-semibold text-slate mb-3">Quels visas de résidence le Panama propose-t-il aux étrangers ?</dt>
        <dd class="text-slate-mid leading-relaxed">
          Le Panama offre plusieurs voies de résidence selon votre situation. Le
          <a href="/fr/visas/pensionado" class="text-jade hover:underline">visa Pensionado</a> est
          conçu pour les retraités percevant une pension viagère d'au moins 1 000 USD/mois — il
          octroie la résidence permanente et un large catalogue de réductions. Le
          <a href="/fr/visas/nations-amies" class="text-jade hover:underline">visa Nations Amies</a> cible
          les ressortissants de 50 pays ayant des liens avec le Panama. Le
          <a href="/fr/visas/investisseur-qualifie" class="text-jade hover:underline">visa Investisseur Qualifié</a> requiert
          un investissement qualifié. Le visa Nomade Digital est destiné aux travailleurs à distance.
          Beyond Panama Relocation couvre chaque visa avec une
          <a href="/fr/visas/comparaison" class="text-jade hover:underline">comparaison détaillée</a>.
        </dd>
      </div>

      <div class="border-b border-jade/10 py-8 pl-5 border-l-4 border-l-jade/30">
        <dt class="font-serif text-xl font-semibold text-slate mb-3">Combien coûte la vie au Panama par mois ?</dt>
        <dd class="text-slate-mid leading-relaxed">
          Le coût de la vie au Panama varie de 1 200 à plus de 5 000 USD par mois. Un couple
          vivant simplement à Boquete peut vivre avec environ 1 620 USD/mois, couvrant loyer,
          alimentation, charges, assurance santé, internet et transports. Le Panama est généralement
          <a href="/fr/cout-de-la-vie" class="text-jade hover:underline">30 à 50 % moins cher</a>
          qu'un mode de vie équivalent aux États-Unis.
        </dd>
      </div>

      <div class="py-8 pl-5 border-l-4 border-l-jade/30">
        <dt class="font-serif text-xl font-semibold text-slate mb-3">Quelles sont les régions les plus populaires pour les expatriés ?</dt>
        <dd class="text-slate-mid leading-relaxed">
          Les régions les plus prisées sont Panama City (la capitale, avec la plus grande
          diversité de services et de prix),
          <a href="/fr/zones/boquete" class="text-jade hover:underline">Boquete</a> (ville de
          montagne au climat frais, communauté d'expatriés bien établie),
          <a href="/fr/zones/coronado" class="text-jade hover:underline">Coronado</a> (station
          balnéaire du Pacifique appréciée des retraités) et Bocas del Toro (archipel caribéen
          au style de vie détendu). Chaque région a un profil distinct en termes de coût,
          de communauté et d'infrastructure.
        </dd>
      </div>

    </dl>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Carrousel d'avis Google — bas de page -->
  <ReviewsCarousel lang="fr" />

  <!-- Rotation du héros — toutes les 5 s -->
  <script>
    const accents = [
      'sans se tromper.',
      'avec le bon visa.',
      'en connaissant vos coûts.',
      'dans la bonne région.',
      'à votre rythme.',
    ];
    const subs = [
      "Informations réelles sur les visas, les quartiers et le coût de la vie — sans pression commerciale, sans promesses vides. Comme un ami qui l'a déjà fait.",
      "Pensionado, Nations Amies, Nomade Digital, Investisseur Qualifié — quel visa correspond à votre situation, expliqué sans jargon juridique.",
      "Coût de vie mensuel réel : à partir de 1 200 $/mois à Boquete jusqu'à 5 000 $+ à Panama City. Des outils pour calculer votre budget exact.",
      "Panama City, Boquete, Coronado, Bocas del Toro — comparatifs réels de prix, profils de communautés d'expatriés et style de vie.",
      "Pour retraités, télétravailleurs, nomades digitaux et investisseurs — tout ce qu'il faut pour prendre la bonne décision sur la vie au Panama.",
    ];

    const accentEl = document.getElementById('hero-accent');
    const subEl    = document.getElementById('hero-sub');
    if (accentEl && subEl) {
      let idx = 0;
      setInterval(() => {
        idx = (idx + 1) % accents.length;
        accentEl.style.opacity = '0';
        subEl.style.opacity    = '0';
        setTimeout(() => {
          accentEl.textContent = accents[idx];
          subEl.textContent    = subs[idx];
          accentEl.style.opacity = '1';
          subEl.style.opacity    = '1';
        }, 500);
      }, 5000);
    }
  </script>

</Layout>
