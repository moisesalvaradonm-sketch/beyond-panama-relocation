---
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data, id }) =>
    !data.draft && data.lang === 'fr' && id.startsWith('fr/')
  );
  return posts.map(post => ({
    params: { slug: post.id.replace('fr/', '') },
    props: { post, allPosts: posts },
  }));
}

const { post, allPosts } = Astro.props;
const { Content } = await render(post);

const categoryLabel: Record<string, string> = {
  zonas: 'Zones et style de vie',
  visas: 'Visas et résidence',
  'costo-de-vida': 'Coût de la vie',
  proceso: 'Processus de déménagement',
  lifestyle: 'Lifestyle',
};

const related = allPosts
  .filter(p => p.id !== post.id && p.data.category === post.data.category)
  .slice(0, 2)
  .concat(
    allPosts
      .filter(p => p.id !== post.id && p.data.category !== post.data.category)
      .slice(0, Math.max(0, 2 - allPosts.filter(p => p.id !== post.id && p.data.category === post.data.category).length))
  )
  .slice(0, 2);

const siteUrl = 'https://beyondpanamarelocation.com';
const pageUrl = Astro.url.href;
const shareTitle = encodeURIComponent(post.data.title);
const shareUrl = encodeURIComponent(pageUrl);
const twitterUrl = `https://twitter.com/intent/tweet?text=${shareTitle}&url=${shareUrl}`;
const whatsappUrl = `https://wa.me/?text=${shareTitle}%20${shareUrl}`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: post.data.pubDate.toISOString(),
  url: pageUrl,
  inLanguage: 'fr',
  author: {
    '@type': 'Person',
    name: 'Moisés Alvarado',
    url: `${siteUrl}/fr/a-propos`,
  },
  publisher: {
    '@type': 'Organization',
    name: 'Beyond Panama Relocation',
    url: siteUrl,
    logo: { '@type': 'ImageObject', url: `${siteUrl}/favicon.svg` },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
};
---

<Layout
  title={post.data.title}
  description={post.data.description}
  lang="fr"
  pubDate={post.data.pubDate}
  articleAuthor="Moisés Alvarado"
  articleSection={categoryLabel[post.data.category] ?? post.data.category}
>
  <article class="max-w-3xl mx-auto px-4 py-16">
    <a href="/fr/blog" class="inline-flex items-center gap-1 text-jade text-sm hover:underline mb-8">
      ← Retour au Blog
    </a>

    <header class="mt-4 mb-10">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold text-jade bg-jade/8 uppercase tracking-wide mb-3">
        {categoryLabel[post.data.category] ?? post.data.category}
      </span>
      <h1 class="font-serif text-4xl text-slate mt-2 mb-3 leading-snug">{post.data.title}</h1>
      <p class="text-slate-mid text-lg leading-relaxed mb-4">{post.data.description}</p>
      <div class="flex flex-wrap gap-4 text-xs text-slate-mid">
        <span>{post.data.pubDate.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
        <span>·</span>
        <span>{post.data.readTime} min de lecture</span>
      </div>
    </header>

    <div class="prose prose-slate max-w-none
      prose-headings:font-serif prose-headings:text-slate
      prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-4
      prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3
      prose-p:text-slate-mid prose-p:leading-relaxed
      prose-li:text-slate-mid
      prose-strong:text-slate
      prose-a:text-jade prose-a:no-underline hover:prose-a:underline
      prose-table:text-sm prose-th:text-slate prose-td:text-slate-mid
      prose-hr:border-jade/10">
      <Content />
    </div>

    <!-- Boutons de partage -->
    <div class="mt-12 pt-8 border-t border-jade/10 flex items-center gap-4">
      <span class="text-xs text-slate-mid font-medium uppercase tracking-wide">Partager</span>
      <a
        href={twitterUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-jade/15 text-sm text-slate-mid hover:border-jade hover:text-jade transition-colors"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.26 5.632 5.903-5.632zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        X / Twitter
      </a>
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-jade/15 text-sm text-slate-mid hover:border-jade hover:text-jade transition-colors"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12.004 0C5.372 0 0 5.373 0 12.004c0 2.117.554 4.1 1.523 5.823L0 24l6.335-1.498A11.955 11.955 0 0012.004 24C18.627 24 24 18.628 24 12.004 24 5.373 18.627 0 12.004 0zm0 21.818a9.81 9.81 0 01-5.001-1.373l-.36-.214-3.726.88.945-3.617-.235-.372A9.795 9.795 0 012.182 12.004c0-5.42 4.41-9.818 9.822-9.818 5.42 0 9.814 4.398 9.814 9.818 0 5.412-4.394 9.814-9.814 9.814z"/></svg>
        WhatsApp
      </a>
    </div>

    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

    <!-- CTA Quiz -->
    <div class="mt-12 p-8 rounded-2xl bg-jade/5 border border-jade/15 text-center">
      <p class="font-serif text-xl text-slate mb-2">Prêt pour la prochaine étape ?</p>
      <p class="text-slate-mid text-sm mb-5">Le quiz vous oriente en 2 minutes selon votre profil et votre budget réel.</p>
      <a href="/fr/quiz" class="inline-flex px-6 py-3 rounded-full bg-jade text-white font-medium text-sm hover:bg-jade-dark transition-colors">
        Faire le quiz →
      </a>
    </div>

    <!-- Articles liés -->
    {related.length > 0 && (
      <aside class="mt-16">
        <h2 class="font-serif text-2xl text-slate mb-6">Articles liés</h2>
        <div class="grid sm:grid-cols-2 gap-5">
          {related.map(rel => (
            <a
              href={`/fr/blog/${rel.id.replace('fr/', '')}`}
              class="group p-5 rounded-2xl bg-white border border-jade/10 hover:border-jade/25 hover:shadow-sm transition-all"
            >
              <span class="text-xs font-semibold text-jade uppercase tracking-wide">
                {categoryLabel[rel.data.category] ?? rel.data.category}
              </span>
              <h3 class="font-serif text-base font-semibold text-slate mt-2 mb-2 leading-snug group-hover:text-jade transition-colors">
                {rel.data.title}
              </h3>
              <p class="text-xs text-slate-mid line-clamp-2 mb-3">{rel.data.description}</p>
              <span class="text-xs text-jade font-medium">Lire → {rel.data.readTime} min</span>
            </a>
          ))}
        </div>
      </aside>
    )}
  </article>
</Layout>
