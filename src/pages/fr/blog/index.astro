---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.filter(p => p.data.lang === 'en' || p.data.lang === 'es');
posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const imagePositions: Record<string, string> = {
  'panama-city-skyline.webp': 'center 28%',
  'friendly-nations-visa.webp': 'center 22%',
  'panama-areas.webp': 'center 42%',
  'panama-passport.webp': 'center 32%',
  'blog-investor-full.webp': 'center 20%',
  'blog-inversionista-full.webp': 'center 20%',
  'blog-investisseur-full.webp': 'center 20%',
  'blog-friendly-full.webp': 'right 12%',
  'blog-renting-panama-full.webp': 'center 30%',
  'blog-alquiler-panama-full.webp': 'center 30%',
};
function imgPos(src?: string) {
  const f = src?.split('/').pop() ?? '';
  return imagePositions[f] ?? 'center';
}
---

<Layout
  title="Blog — Guides et ressources pour vivre au Panama"
  description="Guides pratiques, comparatifs et ressources pour prendre des décisions éclairées sur la vie au Panama. Sans remplissage, sans fausse urgence."
  lang="fr"
>
  <section class="max-w-4xl mx-auto px-4 py-16">
    <div class="mb-10">
      <a href="/fr/" class="text-jade text-sm hover:underline">← Accueil</a>
      <h1 class="font-serif text-4xl text-slate mt-4 mb-3">Blog Relocation Panama — Guides &amp; Ressources</h1>
      <p class="text-slate-mid text-lg max-w-2xl">
        Guides pratiques, comparatifs et ressources pour prendre des décisions éclairées
        sur la vie au Panama. Sans remplissage, sans fausse urgence.
      </p>
    </div>

    <div class="flex flex-wrap gap-2 mb-10">
      {['Visas & résidence', 'Zones & style de vie', 'Coût de la vie', 'Processus de déménagement', 'Lifestyle'].map(cat => (
        <span class="px-3 py-1 rounded-full text-sm bg-white border border-jade/15 text-slate-mid">
          {cat}
        </span>
      ))}
    </div>

    {posts.length > 0 ? (
      <div class="grid md:grid-cols-2 gap-6 mb-12">
        {posts.map(post => {
          const lang = post.data.lang ?? 'en';
          const slug = post.id.replace(/^(es|en)\//, '');
          const href = `/${lang}/blog/${slug}`;
          return (
            <a
              href={href}
              class="group rounded-2xl bg-white border border-jade/10 hover:border-jade/25 hover:shadow-sm transition-all overflow-hidden flex flex-col"
            >
              {post.data.image && (
                <div class="h-44 overflow-hidden">
                  <img
                    src={post.data.image}
                    alt={post.data.imageAlt ?? post.data.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    style={`object-position: ${imgPos(post.data.image)}`}
                  />
                </div>
              )}
              <div class="p-6 flex flex-col flex-1">
                <span class="text-xs font-semibold text-jade uppercase tracking-wide">
                  {post.data.category}
                </span>
                <h2 class="font-serif text-lg font-semibold text-slate mt-2 mb-3 leading-snug group-hover:text-jade transition-colors flex-1">
                  {post.data.title}
                </h2>
                <p class="text-sm text-slate-mid mb-4 line-clamp-2">{post.data.description}</p>
                <div class="flex items-center justify-between mt-auto">
                  <span class="text-xs text-slate-mid">{post.data.readTime} min</span>
                  <span class="text-jade text-sm font-medium">Lire →</span>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    ) : (
      <div class="text-center py-20 text-slate-mid">
        <p class="text-lg mb-2">Articles bientôt disponibles en français.</p>
        <p class="text-sm">En attendant, consultez nos guides en <a href="/en/blog" class="text-jade hover:underline">anglais</a> ou en <a href="/es/blog" class="text-jade hover:underline">espagnol</a>.</p>
      </div>
    )}

    <div class="p-8 rounded-2xl bg-jade/5 border border-jade/15 text-center">
      <p class="font-serif text-xl text-slate mb-2">Vous cherchez quelque chose de spécifique ?</p>
      <p class="text-slate-mid text-sm mb-5 max-w-md mx-auto">
        Faites le quiz de 2 minutes pour obtenir une recommandation personnalisée selon votre situation.
      </p>
      <a href="/fr/quiz" class="px-6 py-3 rounded-full bg-jade text-white font-medium text-sm hover:bg-jade-dark transition-colors">
        Trouver ma route →
      </a>
    </div>

  </section>
</Layout>
