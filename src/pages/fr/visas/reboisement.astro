import VisaPage from '../../../components/ui/VisaPage.astro';
---

<VisaPage
  lang="fr"
  title="Visa Reboisement Panama"
  description="Guide complet du visa Reboisement Panama : investissement 100 000 USD dans un projet forestier certifié, avantages fiscaux, résidence permanente. Pour les investisseurs à sensibilité environnementale."
  visaName="Visa Reboisement"
  tag="Investissement nature"
  tagColor="bg-emerald-50 text-emerald-800"
  mainReq="Investissement minimum de 100 000 USD dans un projet de reboisement certifié au Panama"
  investment="À partir de 100 000 USD (projet forestier certifié)"
  processingTime="4 à 8 mois"
  renewalNote="Résidence temporaire renouvelable · chemin vers la résidence permanente"
  intro="Le visa Reboisement (Visa de Reforestación) est l'une des voies de résidence les plus abordables du Panama, conçue pour les investisseurs engagés dans des projets de reboisement certifiés. En plus de la résidence, il offre des avantages fiscaux significatifs et permet de contribuer activement à la préservation de l'environnement panaméen."
  requirements={[
    "Investissement minimum de 100 000 USD dans un projet de reboisement approuvé par l'Autorité Nationale de l'Environnement du Panama (MiAMBIENTE)",
    "Le projet doit être certifié et enregistré auprès des autorités compétentes",
    "Passeport en cours de validité (original + copies certifiées)",
    "Extrait de casier judiciaire apostillé du pays d'origine",
    "Acte de naissance apostillé",
    "Photos d'identité récentes (format passeport)",
    "Contrat d'investissement avec l'entreprise de reboisement certifiée",
    "Tous les documents étrangers doivent être apostillés ; traduction en espagnol requise",
  ]}
  benefits={[
    "Seuil d'investissement le plus bas parmi les visas d'investissement panaméens (100 000 USD)",
    "Exonération de droits d'importation sur les équipements pour le projet de reboisement",
    "Exonération fiscale sur les revenus générés par le projet pendant 10 à 30 ans (selon la loi forestière)",
    "Résidence temporaire renouvelable avec chemin vers la résidence permanente",
    "Possibilité d'inclure le/la conjoint(e) et les enfants à charge",
    "Contribution active à la préservation des forêts panaméennes",
    "Le Panama n'impose pas sur les revenus de source étrangère",
  ]}
  notFor={[
    "Vous cherchez un retour sur investissement financier rapide — les projets de reboisement ont des horizons longs (10-30 ans)",
    "Vous n'avez pas 100 000 USD à investir dans un projet certifié",
    "Vous voulez un traitement rapide (4 à 8 mois pour ce visa)",
    "Vous préférez un investissement plus liquide (immobilier, dépôt bancaire)",
  ]}
  faqs={[
    {
      q: "Comment trouver un projet de reboisement certifié ?",
      a: "Les projets éligibles doivent être approuvés par MiAMBIENTE (Ministère de l'Environnement du Panama). Il existe plusieurs entreprises certifiées proposant des investissements en reboisement au Panama. Votre avocat panaméen peut vous orienter vers les projets actuellement approuvés et vérifier leur conformité avant tout investissement.",
    },
    {
      q: "Y a-t-il un rendement financier sur l'investissement ?",
      a: "Oui, à long terme. Les projets de reboisement génèrent des revenus via la vente de bois, les crédits carbone et l'agro-foresterie. Les horizons de retour sont typiquement de 10 à 25 ans selon l'essence plantée (teck, cèdre, acajou...). Ce visa convient mieux aux investisseurs à vision long terme et à sensibilité environnementale qu'aux investisseurs cherchant une liquidité rapide.",
    },
    {
      q: "Les avantages fiscaux sont-ils significatifs ?",
      a: "Oui. La loi forestière panaméenne accorde des exonérations fiscales importantes aux projets de reboisement : exonération de l'impôt sur les revenus générés par le projet, exemption de droits d'importation sur les équipements, et exonération de l'impôt foncier sur les terrains reboisés — pendant 10 à 30 ans selon le type de projet.",
    },
    {
      q: "Puis-je inclure ma famille ?",
      a: "Oui. Le/la conjoint(e) légal(e) et les enfants à charge peuvent être inclus en tant que dépendants dans la demande de visa.",
    },
  ]}
/>
