---
import VisaPage from '../../../components/ui/VisaPage.astro';
import WhatsAppCTA from '../../../components/ui/WhatsAppCTA.astro';
---

<VisaPage
  lang="fr"
  title="Visa Nations Amies Panama"
  description="Guide complet du visa Nations Amies Panama : les 50 pays éligibles, 3 voies d'accès, conditions et délais. Résidence permanente pour ressortissants de nations amies."
  visaName="Visa Nations Amies"
  tag="50 pays éligibles"
  tagColor="bg-jade/10 text-jade"
  mainReq="Être ressortissant d'un des 50 pays éligibles + lien économique avec le Panama"
  processingTime="3 à 6 mois (démarche initiale) · puis résidence provisoire de 2 ans"
  renewalNote="Résidence permanente · sans renouvellement · chemin vers la cédula panaméenne"
  intro="Le visa Nations Amies (Visa de Naciones Amigas) permet aux ressortissants de 50 pays entretenantt des relations diplomatiques et économiques fortes avec le Panama d'obtenir la résidence permanente via trois voies : l'immobilier, le dépôt bancaire à terme ou l'emploi au Panama (contrat avec une entreprise panaméenne ou activité via une société que vous créez vous-même)."
  requirements={[
    "Être ressortissant d'un des 50 pays éligibles (voir liste complète en FAQ)",
    "Preuve de lien économique avec le Panama selon la voie choisie (voir ci-dessous)",
    "Passeport en cours de validité (original + copies certifiées)",
    "Extrait de casier judiciaire apostillé du pays d'origine",
    "Acte de naissance apostillé",
    "Photos d'identité récentes (format passeport)",
    "Preuve d'assurance maladie au Panama",
    "Tous les documents étrangers doivent être apostillés ; traduction en espagnol requise",
  ]}
  benefits={[
    "Résidence permanente dès l'approbation — aucun renouvellement requis",
    "Trois voies d'accès : immobilier (200 000 USD+), dépôt à terme (200 000 USD pendant 3 ans) ou emploi dans une entreprise panaméenne",
    "Autorisation de travail incluse pour les titulaires via la voie emploi ou entreprise",
    "Chemin vers la naturalisation panaméenne après 5 ans de résidence",
    "Possibilité d'utiliser un passeport d'un pays éligible (double nationalité)",
    "Possibilité d'inclure le/la conjoint(e) et les enfants mineurs (uniquement)",
    "Le Panama n'impose pas sur les revenus de source étrangère",
    "Démarche initiale de 3 à 6 mois, suivie d'une résidence provisoire de 2 ans",
  ]}
  notFor={[
    "Vous n'êtes pas ressortissant d'un des 50 pays éligibles",
    "Vous ne pouvez pas justifier d'un investissement de 200 000 USD ou d'un contrat de travail panaméen",
    "Vous n'avez pas d'assurance maladie au Panama",
    "Vous cherchez des avantages fiscaux spécifiques liés à la retraite (voir visa Pensionado)",
  ]}
  faqs={[
    {
      q: "Quels sont les 50 pays éligibles au visa Nations Amies ?",
      a: "Les pays éligibles sont : Allemagne, Andorre, Argentine, Australie, Autriche, Belgique, Brésil, Canada, Chili, Chypre, Costa Rica, Croatie, Danemark, Espagne, États-Unis, Finlande, France, Grande-Bretagne, Grèce, Hong Kong, Hongrie, Irlande, Israël, Italie, Japon, Lettonie, Liechtenstein, Lituanie, Luxembourg, Malte, Mexique, Monaco, Monténégro, Norvège, Nouvelle-Zélande, Pays-Bas, Pologne, Portugal, République tchèque, Roumanie, Saint-Marin, Serbie, Singapour, Slovaquie, Slovénie, Suède, Suisse, Taiwan, Uruguay et Vatican.",
    },
    {
      q: "Quelles sont les 3 voies d'accès au visa Nations Amies ?",
      a: "Voie 1 — Immobilier : acheter un bien immobilier au Panama d'une valeur minimale de 200 000 USD. Voie 2 — Dépôt à terme : déposer 200 000 USD minimum dans une banque panaméenne agréée pour une durée de 3 ans. Voie 3 — Emploi : obtenir un contrat de travail avec une entreprise constituée au Panama, ou vous employer via une société que vous créez vous-même.",
    },
    {
      q: "Quel est le délai de traitement du visa Nations Amies ?",
      a: "Le visa Nations Amies La démarche initiale prend généralement de 3 à 6 mois et débouche sur une résidence provisoire de 2 ans, convertible ensuite en résidence permanente.",
    },
    {
      q: "Le visa Nations Amies autorise-t-il à travailler au Panama ?",
      a: "Oui, avec des nuances. La voie emploi inclut automatiquement le droit de travailler pour l'entreprise indiquée dans le contrat. Pour les voies immobilier et dépôt bancaire, l'autorisation de travail n'est pas automatiquement incluse, mais peut être demandée séparément ou via la création d'une société panaméenne.",
    },
    {
      q: "Ce visa peut-il mener à la citoyenneté panaméenne ?",
      a: "Oui. Après 5 ans de résidence permanente effective au Panama, les titulaires du visa Nations Amies peuvent déposer une demande de naturalisation panaméenne. Le Panama accepte la double nationalité avec la plupart des pays.",
    },
  ]}
>
  <WhatsAppCTA
    lang="fr"
    message={{ en: "Hi! I'd like more information about the Friendly Nations visa for Panama.", es: "¡Hola! Quiero más información sobre la visa de Naciones Amigas de Panamá.", fr: "Bonjour ! Je souhaite plus d'informations sur le visa Nations Amies du Panama." }}
    label={{ en: "Get more info on WhatsApp", es: "Pedir más información por WhatsApp", fr: "Plus d'infos sur WhatsApp" }}
  />
</VisaPage>
