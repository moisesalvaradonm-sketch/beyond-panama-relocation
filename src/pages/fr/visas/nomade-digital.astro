  income="3 000 USD/mois minimum (revenus étrangers)"
  processingTime="1 à 2 mois"
  renewalNote="Visa temporaire 9 mois · renouvelable une fois"
  intro="Le visa Nomade Digital du Panama est conçu pour les professionnels qui travaillent à distance pour des employeurs ou clients situés hors du Panama. Il permet de vivre légalement au Panama jusqu'à 9 mois renouvelables, tout en bénéficiant d'une exonération totale d'impôt sur les revenus étrangers."
  requirements={[
    "Revenus d'au moins 36 000 USD/an (3 000 USD/mois) provenant exclusivement d'employeurs ou de clients situés hors du Panama",
    "Passeport en cours de validité (original + copies certifiées)",
    "Extrait de casier judiciaire apostillé du pays d'origine",
    "Preuve de revenus : contrat de travail ou lettres de clients attestant les revenus, + relevés bancaires des 3 derniers mois",
    "Assurance maladie internationale couvrant le Panama",
    "Photos d'identité récentes (format passeport)",
    "Tous les documents doivent être apostillés ; traduction en espagnol requise",
  ]}
  benefits={[
    "Visa temporaire valable 9 mois, renouvelable une fois (soit jusqu'à 18 mois au total)",
    "Exonération totale d'impôt sur les revenus de source étrangère au Panama",
    "Délai de traitement court : 1 à 2 mois",
    "Possibilité d'inclure le/la conjoint(e) et les enfants à charge",
    "Accès aux services bancaires panaméens",
    "Idéal comme première étape avant de passer à la résidence permanente via Nations Amies",
  ]}
  notFor={[
    "Vos revenus proviennent d'une entreprise ou d'un client panaméen",
    "Vous gagnez moins de 3 000 USD/mois de sources étrangères",
    "Vous cherchez une résidence permanente (ce visa est temporaire, 9 mois)",
    "Vous souhaitez travailler localement au Panama",
  ]}
  faqs={[
    {
      q: "Mes revenus doivent-ils provenir d'un seul employeur ?",
      a: "Non. Les revenus peuvent provenir de plusieurs clients ou employeurs étrangers, à condition que tous soient situés hors du Panama. Le total doit atteindre 3 000 USD/mois. Les freelances avec plusieurs clients internationaux sont éligibles.",
    },
    {
      q: "Le visa Nomade Digital exonère-t-il d'impôt au Panama ?",
      a: "Oui. Le Panama applique un système d'imposition territoriale : seuls les revenus générés au Panama sont imposables. Les revenus de source étrangère (d'un employeur ou client hors Panama) ne sont pas imposés au Panama. Vous restez soumis aux obligations fiscales de votre pays de résidence fiscale.",
    },
    {
      q: "Ce visa peut-il mener à la résidence permanente ?",
      a: "Le visa Nomade Digital lui-même ne mène pas directement à la résidence permanente. Cependant, après avoir exploré le Panama via ce visa, beaucoup de titulaires choisissent d'évoluer vers le visa Nations Amies (s'ils sont ressortissants d'un des 50 pays éligibles) ou le visa Investisseur Qualifié pour obtenir la résidence permanente.",
    },
    {
      q: "Puis-je amener ma famille ?",
      a: "Oui. Le/la conjoint(e) et les enfants à charge de moins de 18 ans peuvent être inclus en tant que dépendants. Ils bénéficient du même statut pendant la durée du visa.",
    },
  ]}
/>
