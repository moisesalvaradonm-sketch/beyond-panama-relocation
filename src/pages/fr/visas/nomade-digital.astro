import VisaPage from '../../../components/ui/VisaPage.astro';
---

<VisaPage
  lang="fr"
  title="Visa Nomade Digital Panama"
  description="Guide complet du visa Nomade Digital Panama : conditions de revenus, délais, avantages fiscaux. Pour les télétravailleurs avec 36 000 USD/an de revenus étrangers."
  visaName="Visa Nomade Digital"
  tag="Télétravail"
  tagColor="bg-jade/10 text-jade"
