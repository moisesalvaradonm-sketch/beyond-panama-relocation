---
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('insights', ({ data, id }) =>
    !data.draft && data.lang === 'es' && id.startsWith('es/')
  );
  return posts.map(post => ({
    params: { slug: post.id.replace('es/', '') },
    props: { post, allPosts: posts },
  }));
}

const { post, allPosts } = Astro.props;
const { Content } = await render(post);

const categoryLabel: Record<string, string> = {
  'real-estate': 'Pulso del Mercado',
  legal: 'Consultorio Legal',
  finance: 'Perspectiva Financiera',
  lifestyle: 'Vivir en Panamá',
  'client-story': 'Voces de Expats',
  'moving-guide': 'Guía de Mudanza',
};

const categoryColor: Record<string, string> = {
  'real-estate': 'bg-amber-50 text-amber-700',
  legal: 'bg-blue-50 text-blue-700',
  finance: 'bg-emerald-50 text-emerald-700',
  lifestyle: 'bg-violet-50 text-violet-700',
  'client-story': 'bg-jade/8 text-jade',
  'moving-guide': 'bg-sky-50 text-sky-700',
};

const related = allPosts
  .filter(p => p.id !== post.id && p.data.category === post.data.category)
  .slice(0, 2)
  .concat(
    allPosts
      .filter(p => p.id !== post.id && p.data.category !== post.data.category)
      .slice(0, Math.max(0, 2 - allPosts.filter(p => p.id !== post.id && p.data.category === post.data.category).length))
  )
  .slice(0, 2);

const pageUrl = Astro.url.href;
const shareTitle = encodeURIComponent(post.data.title);
const shareUrl = encodeURIComponent(pageUrl);
const whatsappUrl = `https://wa.me/?text=${shareTitle}%20${shareUrl}`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  url: pageUrl,
  inLanguage: 'es',
  author: {
    '@type': 'Person',
    name: post.data.authorName,
    ...(post.data.authorWebsite ? { sameAs: [post.data.authorWebsite] } : {}),
  },
  publisher: {
    '@type': 'Organization',
    name: 'Beyond Panama Relocation',
    url: 'https://beyondpanamarelocation.com',
  },
};
---

<Layout
  title={post.data.title}
  description={post.data.description}
  lang="es"
  pubDate={post.data.pubDate}
  articleAuthor={post.data.authorName}
  articleSection={categoryLabel[post.data.category] ?? post.data.category}
  ogImage={post.data.image}
>
  <article class="max-w-3xl mx-auto px-4 py-16">

    <a href="/es/insights" class="inline-flex items-center gap-1 text-jade text-sm hover:underline mb-8">
      ← Beyond Insights
    </a>

    {post.data.image && (
      <div class="rounded-2xl overflow-hidden mb-10 -mx-4 sm:mx-0 h-64 sm:h-80">
        <img src={post.data.image} alt={post.data.imageAlt ?? post.data.title} class="w-full h-full object-cover" loading="eager" />
      </div>
    )}

    <header class="mt-4 mb-10">
      <span class={`inline-block px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wide mb-3 ${categoryColor[post.data.category] ?? 'bg-slate/5 text-slate-mid'}`}>
        {categoryLabel[post.data.category] ?? post.data.category}
      </span>
      <h1 class="font-serif text-4xl text-slate mt-2 mb-3 leading-snug">{post.data.title}</h1>
      <p class="text-slate-mid text-lg leading-relaxed mb-6">{post.data.description}</p>

      <div class="flex items-start gap-4 p-4 rounded-xl bg-slate/3 border border-jade/8">
        {post.data.authorAvatar ? (
          <img src={post.data.authorAvatar} alt={post.data.authorName} class="w-12 h-12 rounded-full object-cover flex-shrink-0" />
        ) : (
          <div class="w-12 h-12 rounded-full bg-jade/12 flex items-center justify-center flex-shrink-0">
            <span class="text-jade text-lg font-semibold">{post.data.authorName.charAt(0)}</span>
          </div>
        )}
        <div>
          <p class="font-semibold text-slate text-sm">{post.data.authorName}</p>
          <p class="text-xs text-jade mb-1">{post.data.authorRole}</p>
          {post.data.authorBio && <p class="text-xs text-slate-mid leading-relaxed">{post.data.authorBio}</p>}
        </div>
      </div>

      <div class="flex flex-wrap gap-4 text-xs text-slate-mid mt-4">
        <span>{post.data.pubDate.toLocaleDateString('es-PA', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
        <span>·</span>
        <span>{post.data.readTime} min de lectura</span>
      </div>
    </header>

    <div class="prose prose-slate max-w-none
      prose-headings:font-serif prose-headings:text-slate
      prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-4
      prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3
      prose-p:text-slate-mid prose-p:leading-relaxed
      prose-li:text-slate-mid prose-strong:text-slate
      prose-a:text-jade prose-a:no-underline hover:prose-a:underline
      prose-hr:border-jade/10">
      <Content />
    </div>

    <div class="mt-12 pt-8 border-t border-jade/10 flex items-center gap-4">
      <span class="text-xs text-slate-mid font-medium uppercase tracking-wide">Compartir</span>
      <a href={whatsappUrl} target="_blank" rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-jade/15 text-sm text-slate-mid hover:border-jade hover:text-jade transition-colors">
        WhatsApp
      </a>
    </div>

    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

    {(post.data.authorWebsite || post.data.authorPhone) && (
      <div class="mt-12 p-6 rounded-2xl border border-jade/15 bg-white flex flex-col sm:flex-row items-center gap-5 sm:gap-6">
        <div class="flex-1 text-center sm:text-left">
          <p class="font-serif text-lg text-slate mb-1">¿Necesitas ayuda con tus documentos?</p>
          <p class="text-sm text-slate-mid">Contacta directamente a {post.data.authorName} — {post.data.authorRole}.</p>
        </div>
        <div class="flex gap-3 flex-shrink-0">
          {post.data.authorWebsite && (
            <a href={post.data.authorWebsite} target="_blank" rel="noopener noreferrer"
              class="inline-flex px-5 py-2.5 rounded-full bg-jade text-white text-sm font-medium hover:bg-jade-dark transition-colors">
              Sitio web →
            </a>
          )}
          {post.data.authorPhone && (
            <a href={`tel:${post.data.authorPhone}`}
              class="inline-flex px-5 py-2.5 rounded-full border border-jade/30 text-jade text-sm font-medium hover:bg-jade/5 transition-colors">
              Llamar
            </a>
          )}
        </div>
      </div>
    )}

    <div class="mt-12 p-8 rounded-2xl bg-jade/5 border border-jade/15 text-center">
      <p class="font-serif text-xl text-slate mb-2">¿Listo para tu próximo paso?</p>
      <p class="text-slate-mid text-sm mb-5">El quiz te orienta en 2 minutos según tu perfil y presupuesto real.</p>
      <a href="/es/quiz" class="inline-flex px-6 py-3 rounded-full bg-jade text-white font-medium text-sm hover:bg-jade-dark transition-colors">
        Tomar el quiz →
      </a>
    </div>

    {related.length > 0 && (
      <aside class="mt-16">
        <h2 class="font-serif text-2xl text-slate mb-6">Más de Beyond Insights</h2>
        <div class="grid sm:grid-cols-2 gap-5">
          {related.map(rel => (
            <a href={`/es/insights/${rel.id.replace('es/', '')}`}
              class="group p-5 rounded-2xl bg-white border border-jade/10 hover:border-jade/25 hover:shadow-sm transition-all">
              <span class="text-xs font-semibold text-jade uppercase tracking-wide">{categoryLabel[rel.data.category] ?? rel.data.category}</span>
              <h3 class="font-serif text-base font-semibold text-slate mt-2 mb-2 leading-snug group-hover:text-jade transition-colors">{rel.data.title}</h3>
              <p class="text-xs text-slate-mid mb-3">{rel.data.authorName}</p>
              <span class="text-xs text-jade font-medium">Leer → {rel.data.readTime} min</span>
            </a>
          ))}
        </div>
      </aside>
    )}

  </article>
</Layout>
