---
import Layout from '../../layouts/Layout.astro';
import Quiz from '../../components/quiz/Quiz';

const quizSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Quiz de Visa para Panamá',
  url: 'https://beyondpanamarelocation.com/es/quiz/',
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'Web',
  description: 'Encuentra tu ruta hacia Panamá en 2 minutos según tu perfil y presupuesto reales.',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  inLanguage: 'es-PA',
};
---

<Layout
  title="Tu Ruta a Panamá"
  description="Encuentra tu ruta en 2 minutos según lo que realmente buscas en Panamá."
  lang="es"
>
  <script type="application/ld+json" set:html={JSON.stringify(quizSchema)} />
  <!-- Formulario oculto para que Netlify lo detecte en el build -->
  <form name="quiz-subscribe-es" data-netlify="true" netlify-honeypot="bot-field" hidden>
    <input type="text" name="name" />
    <input type="email" name="email" />
    <input type="tel" name="phone" />
    <input type="hidden" name="clima" />
    <input type="hidden" name="comunidad" />
    <input type="hidden" name="actividades" />
    <input type="hidden" name="presupuesto_prop" />
    <input type="hidden" name="tipo_prop" />
    <input type="hidden" name="espanol" />
    <input type="hidden" name="plazo" />
    <input type="hidden" name="origen" />
    <input type="hidden" name="etapa" />
    <input type="hidden" name="proposito" />
    <input type="hidden" name="trabajo" />
    <input type="hidden" name="acompanantes" />
    <input type="hidden" name="visita" />
    <input type="hidden" name="notas" />
    <input type="hidden" name="contacto" />
    <input name="bot-field" />
  </form>

  <section class="max-w-2xl mx-auto px-4 py-16">
    <div class="text-center mb-10">
      <span class="text-jade text-sm font-medium uppercase tracking-widest">Tu ruta personalizada</span>
      <h1 class="font-serif text-3xl md:text-4xl text-slate mt-2 mb-3">
        ¿Qué buscas en Panamá?
      </h1>
      <p class="text-slate-mid">
        2 minutos · sin registro · sin compromiso
      </p>
    </div>
    <Quiz lang="es" client:load />
  </section>
</Layout>
