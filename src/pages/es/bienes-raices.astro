---
import Layout from '../../layouts/Layout.astro';
import RelatedGuides from '../../components/ui/RelatedGuides.astro';
import RealEstateForm from '../../components/ui/RealEstateForm.astro';
import RealEstateHero from '../../components/ui/RealEstateHero.astro';
---

<Layout
  title="Opciones de Bienes Raíces en Panamá"
  description="Encuentra propiedades en Panamá para comprar, invertir o alquilar. Te conectamos con agentes inmobiliarios con licencia según tus objetivos, presupuesto y zona de preferencia — gratis y sin compromiso."
  lang="es"
>

  <RealEstateHero lang="es" />

  <!-- Intro + value prop -->
  <section class="max-w-5xl mx-auto px-6 md:px-8 py-16 md:py-20">
    <div class="grid md:grid-cols-2 gap-12 items-start">
      <div>
        <h2 class="font-serif text-3xl text-slate mb-5 leading-snug">
          Te conectamos con el profesional inmobiliario adecuado
        </h2>
        <p class="text-slate-mid leading-relaxed mb-6">
          Ya sea que estés buscando comprar una casa, invertir en bienes raíces, alquilar una propiedad o simplemente explorar tus opciones, trabajamos con agentes y corredores inmobiliarios con licencia en Panamá para conectarte con propiedades que se adapten a tus necesidades.
        </p>
        <p class="text-slate-mid leading-relaxed">
          Cuéntanos qué estás buscando y te conectaremos con el profesional inmobiliario adecuado y las opciones relevantes — sin costo y sin ningún compromiso.
        </p>
      </div>

      <div class="space-y-4">
        <div class="rounded-xl bg-white border border-jade/10 p-5 flex gap-4">
          <div class="w-9 h-9 rounded-full bg-jade/10 flex items-center justify-center flex-shrink-0 mt-0.5">
            <svg class="w-4 h-4 text-jade" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
          </div>
          <div>
            <p class="text-sm font-semibold text-slate">Comprar o invertir</p>
            <p class="text-xs text-slate-mid mt-0.5">Ciudad de Panamá hasta zonas costeras — apartamentos, casas, terrenos y comerciales</p>
          </div>
        </div>
        <div class="rounded-xl bg-white border border-jade/10 p-5 flex gap-4">
          <div class="w-9 h-9 rounded-full bg-jade/10 flex items-center justify-center flex-shrink-0 mt-0.5">
            <svg class="w-4 h-4 text-jade" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
            </svg>
          </div>
          <div>
            <p class="text-sm font-semibold text-slate">Propiedades con potencial de residencia</p>
            <p class="text-xs text-slate-mid mt-0.5">Algunas inversiones califican para los programas de residencia en Panamá</p>
          </div>
        </div>
        <div class="rounded-xl bg-white border border-jade/10 p-5 flex gap-4">
          <div class="w-9 h-9 rounded-full bg-jade/10 flex items-center justify-center flex-shrink-0 mt-0.5">
            <svg class="w-4 h-4 text-jade" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <div>
            <p class="text-sm font-semibold text-slate">Sin comisión para compradores</p>
            <p class="text-xs text-slate-mid mt-0.5">Nuestro servicio de conexión es completamente gratuito para quienes buscan propiedades</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Form section -->
  <section class="bg-cream border-t border-jade/8">
    <div class="max-w-3xl mx-auto px-6 md:px-8 py-16 md:py-20">
      <div class="mb-10 text-center">
        <span class="text-jade text-xs font-semibold uppercase tracking-widest">Búsqueda de propiedades</span>
        <h2 class="font-serif text-3xl md:text-4xl text-slate mt-3 mb-3">Cuéntanos Qué Estás Buscando</h2>
        <p class="text-slate-mid text-sm md:text-base max-w-lg mx-auto">
          5 pasos · gratis · sin compromiso
        </p>
      </div>
      <div class="bg-white rounded-2xl border border-jade/10 shadow-sm p-6 md:p-10">
        <RealEstateForm lang="es" />
      </div>
    </div>
  </section>

  <!-- Areas covered -->
  <section class="max-w-5xl mx-auto px-6 md:px-8 py-16">
    <h2 class="font-serif text-2xl text-slate mb-8">Zonas que cubrimos</h2>
    <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-4">
      {[
        { name: 'Ciudad de Panamá', desc: 'Capital, hub financiero, amplia gama de precios' },
        { name: 'Coronado', desc: 'Costa del Pacífico, popular entre jubilados y expatriados' },
        { name: 'Boquete', desc: 'Ciudad de montaña, clima fresco, comunidad expat consolidada' },
        { name: 'Bocas del Toro', desc: 'Archipiélago caribeño, estilo de vida relajado' },
        { name: 'Pedasí y Costa del Pacífico', desc: 'Pueblos pesqueros, surf, potencial de inversión' },
        { name: 'Otras regiones', desc: 'Cuéntanos qué tienes en mente' },
      ].map(area => (
        <div class="rounded-xl bg-white border border-jade/10 p-5">
          <p class="font-semibold text-slate text-sm mb-1">{area.name}</p>
          <p class="text-xs text-slate-mid">{area.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <RelatedGuides lang="es" categories={['proceso', 'zonas']} />
</Layout>
