---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

const posts = await getCollection('blog', ({ data, id }) =>
  !data.draft && data.lang === 'es' && id.startsWith('es/')
);
posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const categoryLabel: Record<string, string> = {
  zonas: 'Zonas y estilo de vida',
  visas: 'Visas y trámites',
  'costo-de-vida': 'Costo de vida',
  proceso: 'Proceso de mudanza',
  lifestyle: 'Lifestyle',
};
---

<Layout
  title="Blog — Guías y recursos para vivir en Panamá"
  description="Guías, comparativas y recursos prácticos para extranjeros que quieren vivir en Panamá. Contenido en español e inglés."
  lang="es"
>
  <section class="max-w-4xl mx-auto px-4 py-16">
    <div class="mb-10">
      <a href="/es/" class="text-jade text-sm hover:underline">← Inicio</a>
      <h1 class="font-serif text-4xl text-slate mt-4 mb-3">Blog</h1>
      <p class="text-slate-mid text-lg max-w-2xl">
        Guías prácticas, comparativas y recursos para tomar decisiones informadas
        sobre vivir en Panamá. Sin relleno, sin urgencia falsa.
      </p>
    </div>

    <!-- Categorías -->
    <div class="flex flex-wrap gap-2 mb-10">
      {['Visas y trámites', 'Zonas y estilo de vida', 'Costo de vida', 'Proceso de mudanza', 'Lifestyle'].map(cat => (
        <span class="px-3 py-1 rounded-full text-sm bg-white border border-jade/15 text-slate-mid">
          {cat}
        </span>
      ))}
    </div>

    <!-- Artículos publicados -->
    {posts.length > 0 && (
      <div class="grid md:grid-cols-2 gap-6 mb-12">
        {posts.map(post => (
          <a
            href={`/es/blog/${post.id.replace('es/', '')}`}
            class="group rounded-2xl bg-white border border-jade/10 hover:border-jade/25 hover:shadow-sm transition-all overflow-hidden flex flex-col"
          >
            {post.data.image && (
              <div class="h-44 overflow-hidden">
                <img
                  src={post.data.image}
                  alt={post.data.imageAlt ?? post.data.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
              </div>
            )}
            <div class="p-6 flex flex-col flex-1">
              <span class="text-xs font-semibold text-jade uppercase tracking-wide">
                {categoryLabel[post.data.category] ?? post.data.category}
              </span>
              <h2 class="font-serif text-lg font-semibold text-slate mt-2 mb-3 leading-snug group-hover:text-jade transition-colors flex-1">
                {post.data.title}
              </h2>
              <p class="text-sm text-slate-mid mb-4 line-clamp-2">{post.data.description}</p>
              <div class="flex items-center justify-between mt-auto">
                <span class="text-xs text-slate-mid">{post.data.readTime} min de lectura</span>
                <span class="text-jade text-sm font-medium">Leer →</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    )}

    <div class="text-center p-8 rounded-2xl bg-jade/5 border border-jade/15">
      <p class="font-serif text-xl text-slate mb-2">Más guías en camino</p>
      <p class="text-slate-mid text-sm mb-5">Publicamos regularmente. Mientras tanto, tu ruta es la forma más rápida de orientarte.</p>
      <a href="/es/quiz" class="inline-flex px-6 py-3 rounded-full bg-jade text-white font-medium text-sm hover:bg-jade-dark transition-colors">
        Encontrar tu ruta →
      </a>
    </div>
  </section>
</Layout>
