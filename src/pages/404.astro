---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page not found"
  description="This page doesn't exist. Head back to the guide to explore visas, areas and cost of living in Panama."
  lang="en"
  noindex={true}
>
  <section class="max-w-2xl mx-auto px-6 py-32 text-center">
    <p class="font-serif text-8xl text-jade/20 font-bold leading-none mb-6">404</p>
    <h1 class="font-serif text-3xl text-slate mb-4">This page doesn't exist</h1>
    <p class="text-slate-mid text-lg mb-10 leading-relaxed">
      The page you're looking for has moved or doesn't exist. Use the links below to get back on track.
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center mb-16">
      <a href="/en/" class="inline-flex px-6 py-3 rounded-full bg-jade text-white font-medium text-sm hover:bg-jade-dark transition-colors">
        ← Back to home
      </a>
      <a href="/en/quiz/" class="inline-flex px-6 py-3 rounded-full border border-jade/25 text-jade font-medium text-sm hover:bg-jade/5 transition-colors">
        Take the quiz →
      </a>
    </div>
    <div class="grid sm:grid-cols-3 gap-4 text-left">
      <a href="/en/visas/" class="p-5 rounded-2xl bg-white border border-jade/10 hover:border-jade/25 hover:shadow-sm transition-all">
        <p class="text-xs font-semibold text-jade uppercase tracking-wide mb-1">Visas & Residency</p>
        <p class="text-sm text-slate-mid">Pensionado, Friendly Nations, Digital Nomad and more</p>
      </a>
      <a href="/en/areas/" class="p-5 rounded-2xl bg-white border border-jade/10 hover:border-jade/25 hover:shadow-sm transition-all">
        <p class="text-xs font-semibold text-jade uppercase tracking-wide mb-1">Areas to Live</p>
        <p class="text-sm text-slate-mid">Panama City, Boquete, Coronado, Bocas del Toro</p>
      </a>
      <a href="/en/cost-of-living/" class="p-5 rounded-2xl bg-white border border-jade/10 hover:border-jade/25 hover:shadow-sm transition-all">
        <p class="text-xs font-semibold text-jade uppercase tracking-wide mb-1">Cost of Living</p>
        <p class="text-sm text-slate-mid">Real monthly costs by area and lifestyle</p>
      </a>
    </div>
  </section>
</Layout>
